{
  "title": "Coronation",

  "stats": [
    { "key": "round",       "label": "Round" },
    { "key": "progress",    "label": "Progress",  "min": 0 },
    { "key": "stability",   "label": "Stability", "min": 0, "max": 10 },
    { "key": "gold",        "label": "Gold",      "min": 0 },
    { "key": "food",        "label": "Food",      "min": 0 },
    { "key": "might",       "label": "Might",     "min": 0 },
    { "key": "mana",        "label": "Mana",      "min": 0 },
    { "key": "destination", "hidden": true }
  ],

  "setup": {
    "player": { "stability": 10, "gold": 4, "food": 2, "might": 0, "mana": 0,
                "progress": 0, "destination": 1 }
  },

  "templates": [

    { "key": "merchant_prince", "text": "Merchant Prince", "asset": "stranger.png",
      "tooltip": "Born to ledgers and caravans. +6 gold.",
      "tags": ["holding", "origin", "economic"], "card_stats": { "hp": 4, "hp_max": 4 },
      "on_play": ["move_to:board", "gain_stat:progress:3", "gain_stat:gold:6"] },
    { "key": "warlord", "text": "Warlord", "asset": "bandits.png",
      "tooltip": "Crowned on a battlefield. +3 might.",
      "tags": ["holding", "origin", "military", "soldier"], "card_stats": { "hp": 5, "hp_max": 5 },
      "on_play": ["move_to:board", "gain_stat:progress:3", "gain_stat:might:3"] },
    { "key": "archmage", "text": "Archmage", "asset": "storm.png",
      "tooltip": "The tower chose you. +2 mana now, +1 each round.",
      "tags": ["holding", "origin", "mystic"], "card_stats": { "hp": 3, "hp_max": 3 },
      "on_play": ["move_to:board", "gain_stat:progress:3", "gain_stat:mana:2"],
      "on_turn": ["gain_stat:mana:1"] },
    { "key": "decline", "text": "Decline", "color": [0.10, 0.14, 0.22],
      "tooltip": "Claim no birthright. Begin with nothing.",
      "tags": ["token"], "on_play": ["destroy_self"] },

    { "key": "to_market", "text": "Visit the Market", "color": [0.12, 0.17, 0.14],
      "tooltip": "End this season and browse the Market next. Play at least one card first.",
      "tags": ["token"], "needs": { "plays": 1 },
      "on_play": ["set_stat:destination:1", "destroy_self", "next_phase"] },
    { "key": "to_barracks", "text": "Visit the Barracks", "color": [0.18, 0.13, 0.12],
      "tooltip": "End this season and train at the Barracks next. Play at least one card first.",
      "tags": ["token"], "needs": { "plays": 1 },
      "on_play": ["set_stat:destination:2", "destroy_self", "next_phase"] },
    { "key": "to_sanctum", "text": "Visit the Sanctum", "color": [0.14, 0.12, 0.19],
      "tooltip": "End this season and seek the Sanctum next. Play at least one card first.",
      "tags": ["token"], "needs": { "plays": 1 },
      "on_play": ["set_stat:destination:3", "destroy_self", "next_phase"] },
    { "key": "rest", "text": "Rest", "color": [0.10, 0.14, 0.22],
      "tooltip": "End the season once both trials are faced.",
      "tags": ["token"], "needs": { "plays": 2 },
      "on_play": ["destroy_self", "next_phase"] },

    { "key": "homestead", "text": "Homestead", "asset": "shelter.png",
      "tooltip": "A family stakes its claim. +1 food each round.",
      "tags": ["holding", "economic", "farm"], "card_stats": { "hp": 3, "hp_max": 3 },
      "on_play": ["move_to:board", "gain_stat:progress:1"],
      "on_turn": ["gain_stat:food:1"] },
    { "key": "market_square", "text": "Market Square", "asset": "village.png",
      "tooltip": "Trade finds its center. +1 gold each round.",
      "cost": { "gold": 2 },
      "tags": ["holding", "economic"], "card_stats": { "hp": 3, "hp_max": 3 },
      "on_play": ["move_to:board", "gain_stat:progress:1"],
      "on_turn": ["gain_stat:gold:1"] },
    { "key": "granary", "text": "Granary", "asset": "shelter.png",
      "tooltip": "Stores every harvest: +1 food per farm, each round.",
      "cost": { "food": 2 },
      "tags": ["holding", "economic"], "card_stats": { "hp": 3, "hp_max": 3 },
      "on_play": ["move_to:board", "gain_stat:progress:1"],
      "on_turn": ["gain_stat:food:count:farm"] },
    { "key": "toll_roads", "text": "Toll Roads", "asset": "world.jpg",
      "tooltip": "Every wagon pays: +1 gold per economic holding, each round.",
      "cost": { "gold": 3 },
      "tags": ["holding", "economic"], "card_stats": { "hp": 3, "hp_max": 3 },
      "on_play": ["move_to:board", "gain_stat:progress:1"],
      "on_turn": ["gain_stat:gold:count:economic"] },
    { "key": "laborers", "text": "Laborers", "asset": "stranger.png",
      "tooltip": "Willing hands. Gain 2 gold.",
      "tags": ["one_shot"],
      "on_play": ["gain_stat:gold:2", "move_to:graveyard"] },
    { "key": "royal_mint", "text": "Royal Mint", "asset": "village.png",
      "tooltip": "The crown's own coin. +2 gold each round.",
      "cost": { "gold": 6 },
      "tags": ["holding", "economic"], "card_stats": { "hp": 4, "hp_max": 4 },
      "on_play": ["move_to:board", "gain_stat:progress:3"],
      "on_turn": ["gain_stat:gold:2"] },

    { "key": "militia", "text": "Militia", "asset": "bandits.png",
      "tooltip": "Farmhands with spears. +1 might.",
      "tags": ["holding", "military", "soldier"], "card_stats": { "hp": 2, "hp_max": 2 },
      "on_play": ["move_to:board", "gain_stat:might:1", "gain_stat:progress:1"] },
    { "key": "garrison", "text": "Garrison", "asset": "village.png",
      "tooltip": "Stone walls and steady watch. +2 might.",
      "cost": { "gold": 2 },
      "tags": ["holding", "military", "soldier"], "card_stats": { "hp": 4, "hp_max": 4 },
      "on_play": ["move_to:board", "gain_stat:might:2", "gain_stat:progress:1"] },
    { "key": "war_college", "text": "War College", "asset": "ruins.jpg",
      "tooltip": "Drill the ranks: +1 might per soldier. Once per round.",
      "cost": { "gold": 3 },
      "tags": ["holding", "military"], "card_stats": { "hp": 3, "hp_max": 3 },
      "on_play": ["move_to:board", "gain_stat:progress:1"],
      "activate_cost": { "food": 1 },
      "on_activate": ["gain_stat:might:count:soldier"] },
    { "key": "mercenary_band", "text": "Mercenary Band", "asset": "bandits.png",
      "tooltip": "Loyal while paid. +3 might.",
      "cost": { "gold": 3 }, "tags": ["one_shot"],
      "on_play": ["gain_stat:might:3", "move_to:graveyard"] },
    { "key": "rally_banner", "text": "Rally Banner", "asset": "bandits.png",
      "tooltip": "The banners rise: +1 might per soldier.",
      "tags": ["one_shot"], "needs": { "count:soldier": 2 },
      "on_play": ["gain_stat:might:count:soldier", "gain_stat:progress:1", "move_to:graveyard"] },
    { "key": "siege_works", "text": "Siege Works", "asset": "ruins.jpg",
      "tooltip": "Engines that end arguments. +2 might.",
      "cost": { "gold": 4 },
      "tags": ["holding", "military"], "card_stats": { "hp": 3, "hp_max": 3 },
      "on_play": ["move_to:board", "gain_stat:might:2", "gain_stat:progress:2"] },

    { "key": "shrine", "text": "Shrine", "asset": "ruins.jpg",
      "tooltip": "A quiet altar. +1 mana.",
      "tags": ["holding", "mystic"], "card_stats": { "hp": 2, "hp_max": 2 },
      "on_play": ["move_to:board", "gain_stat:mana:1", "gain_stat:progress:1"] },
    { "key": "moon_circle", "text": "Moon Circle", "asset": "storm.png",
      "tooltip": "Chants under the open sky: +1 mana each round.",
      "cost": { "gold": 2 },
      "tags": ["holding", "mystic"], "card_stats": { "hp": 3, "hp_max": 3 },
      "on_play": ["move_to:board", "gain_stat:progress:1"],
      "on_turn": ["gain_stat:mana:1"] },
    { "key": "seer_tower", "text": "Seer's Tower", "asset": "storm.png",
      "tooltip": "The stars answer: +1 mana per mystic holding, each round.",
      "cost": { "mana": 2 },
      "tags": ["holding", "mystic"], "card_stats": { "hp": 3, "hp_max": 3 },
      "on_play": ["move_to:board", "gain_stat:progress:1"],
      "on_turn": ["gain_stat:mana:count:mystic"] },
    { "key": "eclipse_rite", "text": "Eclipse Rite", "asset": "storm.png",
      "tooltip": "Spend 4 mana: the realm remembers. +2 progress. Once per round.",
      "cost": { "mana": 3 },
      "tags": ["holding", "mystic"], "card_stats": { "hp": 2, "hp_max": 2 },
      "on_play": ["move_to:board", "gain_stat:progress:1"],
      "activate_cost": { "mana": 4 },
      "on_activate": ["gain_stat:progress:2"] },
    { "key": "offering", "text": "Offering", "asset": "stranger.png",
      "tooltip": "Wine and silver for the spirits. +2 mana.",
      "tags": ["one_shot"],
      "on_play": ["gain_stat:mana:2", "move_to:graveyard"] },
    { "key": "warding_circle", "text": "Warding Circle", "asset": "ruins.jpg",
      "tooltip": "Spirits stand guard: spend 2 mana for +2 might. Once per round.",
      "cost": { "mana": 2 },
      "tags": ["holding", "mystic"], "card_stats": { "hp": 3, "hp_max": 3 },
      "on_play": ["move_to:board", "gain_stat:progress:1"],
      "activate_cost": { "mana": 2 },
      "on_activate": ["gain_stat:might:2"] },

    { "key": "harvest_blight", "text": "Harvest Blight", "asset": "storm.png",
      "tooltip": "Blight creeps through the fields. Need 4 food.",
      "tags": ["trial"], "requires": { "food": 4 },
      "on_pass": ["lose_stat:food:2", "gain_stat:progress:1"],
      "on_fail": ["lose_stat:stability:1", "damage_random:farm:hp:2"],
      "on_play": ["move_to:graveyard", "resolve_challenge"] },
    { "key": "border_raid", "text": "Border Raid", "asset": "bandits.png",
      "tooltip": "Riders burn the frontier. Need 3 might.",
      "tags": ["trial"], "requires": { "might": 3 },
      "on_pass": ["lose_stat:might:1", "gain_stat:progress:1"],
      "on_fail": ["lose_stat:stability:2"],
      "on_play": ["move_to:graveyard", "resolve_challenge"] },
    { "key": "debt_collectors", "text": "Debt Collectors", "asset": "stranger.png",
      "tooltip": "Old debts come due. Need 6 gold.",
      "tags": ["trial"], "requires": { "gold": 6 },
      "on_pass": ["lose_stat:gold:4", "gain_stat:progress:1"],
      "on_fail": ["lose_stat:stability:1", "damage_random:economic:hp:2"],
      "on_play": ["move_to:graveyard", "resolve_challenge"] },
    { "key": "restless_spirits", "text": "Restless Spirits", "asset": "ruins.jpg",
      "tooltip": "The dead whisper louder. Need 3 mana.",
      "tags": ["trial"], "requires": { "mana": 3 },
      "on_pass": ["lose_stat:mana:2", "gain_stat:progress:1"],
      "on_fail": ["lose_stat:stability:1", "damage_random:mystic:hp:2"],
      "on_play": ["move_to:graveyard", "resolve_challenge"] },

    { "key": "famine", "text": "Famine", "asset": "storm.png",
      "tooltip": "Two lean years in a row. Need 2 farms.",
      "tags": ["trial"], "requires": { "count:farm": 2 },
      "on_pass": ["lose_stat:food:3", "gain_stat:progress:2"],
      "on_fail": ["lose_stat:stability:2", "damage_random:farm:hp:2"],
      "on_play": ["move_to:graveyard", "resolve_challenge"] },
    { "key": "mercenary_uprising", "text": "Mercenary Uprising", "asset": "bandits.png",
      "tooltip": "The sellswords name their price. Need 8 gold.",
      "tags": ["trial"], "requires": { "gold": 8 },
      "on_pass": ["lose_stat:gold:6", "gain_stat:progress:2"],
      "on_fail": ["lose_stat:stability:2", "damage_random:military:hp:3"],
      "on_play": ["move_to:graveyard", "resolve_challenge"] },
    { "key": "war_host", "text": "War Host", "asset": "bandits.png",
      "tooltip": "A rival banner marches. Need 6 might.",
      "tags": ["trial"], "requires": { "might": 6 },
      "on_pass": ["lose_stat:might:3", "gain_stat:progress:2"],
      "on_fail": ["lose_stat:stability:3"],
      "on_play": ["move_to:graveyard", "resolve_challenge"] },
    { "key": "witch_hunt", "text": "Witch Hunt", "asset": "ruins.jpg",
      "tooltip": "Fear turns on the wise. Need 6 mana.",
      "tags": ["trial"], "requires": { "mana": 6 },
      "on_pass": ["lose_stat:mana:3", "gain_stat:progress:2"],
      "on_fail": ["lose_stat:stability:2", "damage_random:mystic:hp:3"],
      "on_play": ["move_to:graveyard", "resolve_challenge"] },

    { "key": "war_of_succession", "text": "War of Succession", "asset": "ruins.jpg",
      "tooltip": "Cousins with armies. Need 8 might and 8 gold.",
      "tags": ["trial"], "requires": { "might": 8, "gold": 8 },
      "on_pass": ["lose_stat:might:4", "lose_stat:gold:6", "gain_stat:progress:2"],
      "on_fail": ["lose_stat:stability:3", "damage_random:holding:hp:2"],
      "on_play": ["move_to:graveyard", "resolve_challenge"] },
    { "key": "long_winter", "text": "The Long Winter", "asset": "storm.png",
      "tooltip": "It does not thaw. Need 8 food and 3 farms.",
      "tags": ["trial"], "requires": { "food": 8, "count:farm": 3 },
      "on_pass": ["lose_stat:food:5", "gain_stat:progress:2"],
      "on_fail": ["lose_stat:stability:3", "damage_random:farm:hp:3"],
      "on_play": ["move_to:graveyard", "resolve_challenge"] },
    { "key": "dragon", "text": "The Dragon", "asset": "storm.png",
      "tooltip": "It remembers where gold sleeps. Need 10 might and 4 mana.",
      "tags": ["trial"], "requires": { "might": 10, "mana": 4 },
      "on_pass": ["lose_stat:might:4", "lose_stat:mana:2", "gain_stat:progress:3"],
      "on_fail": ["lose_stat:stability:4", "damage_random:holding:hp:4"],
      "on_play": ["move_to:graveyard", "resolve_challenge"] },

    { "key": "crown", "text": "The Coronation", "asset": "world.jpg",
      "tooltip": "Bells in every tower — the realm is whole and yours. Click to return to the menu." },
    { "key": "ruin", "text": "The Fall", "asset": "ruins.jpg",
      "tooltip": "The gates stand open and the throne stands empty. Click to return to the menu." },
    { "key": "twilight", "text": "Twilight Years", "asset": "shelter.png",
      "tooltip": "No crown, no ruin — the seasons simply carry on without you. Click to return to the menu." }
  ],

  "zones": [
    { "key": "board", "type": "grid", "pos": [0.00, 0.00, 0.75, 0.70], "grid": [5, 5] },
    { "key": "hand",  "type": "hand", "pos": [0.00, 0.72, 0.75, 0.99] },
    { "key": "origins", "type": "deck", "pos": [0.42, -0.40, 0.58, -0.08], "tags": ["hidden", "shuffle"],
      "contents": ["merchant_prince", "warlord", "archmage"] },
    { "key": "market_deck", "label": "Market", "type": "deck", "pos": [0.77, 0.02, 0.99, 0.20],
      "tags": ["shuffle", "refill_when_empty"],
      "contents": ["homestead:3", "market_square:2", "granary:2", "toll_roads:1", "laborers:2", "royal_mint:1"] },
    { "key": "barracks_deck", "label": "Barracks", "type": "deck", "pos": [0.77, 0.22, 0.99, 0.40],
      "tags": ["shuffle", "refill_when_empty"],
      "contents": ["militia:3", "garrison:2", "war_college:1", "mercenary_band:2", "rally_banner:2", "siege_works:1"] },
    { "key": "sanctum_deck", "label": "Sanctum", "type": "deck", "pos": [0.77, 0.42, 0.99, 0.60],
      "tags": ["shuffle", "refill_when_empty"],
      "contents": ["shrine:3", "moon_circle:2", "seer_tower:1", "eclipse_rite:1", "offering:2", "warding_circle:2"] },
    { "key": "trials1", "label": "Trials I", "type": "deck", "pos": [0.77, 0.62, 0.842, 0.78],
      "tags": ["shuffle", "refill_when_empty"],
      "contents": ["harvest_blight", "border_raid", "debt_collectors", "restless_spirits"] },
    { "key": "trials2", "label": "Trials II", "type": "deck", "pos": [0.849, 0.62, 0.921, 0.78],
      "tags": ["shuffle", "refill_when_empty"],
      "contents": ["famine", "mercenary_uprising", "war_host", "witch_hunt"] },
    { "key": "trials3", "label": "Trials III", "type": "deck", "pos": [0.928, 0.62, 0.99, 0.78],
      "tags": ["shuffle", "refill_when_empty"],
      "contents": ["war_of_succession", "long_winter", "dragon"] },
    { "key": "graveyard", "label": "Discard", "type": "pile", "pos": [0.77, 0.80, 0.99, 0.99] },
    { "key": "offer", "type": "hand", "pos": [0.15, 0.32, 0.85, 0.70], "tags": ["hidden"] },
    { "key": "fate_crown",    "type": "deck", "pos": [0.42, -0.40, 0.58, -0.08], "tags": ["hidden"],
      "contents": ["crown"] },
    { "key": "fate_ruin",     "type": "deck", "pos": [0.42, -0.40, 0.58, -0.08], "tags": ["hidden"],
      "contents": ["ruin"] },
    { "key": "fate_twilight", "type": "deck", "pos": [0.42, -0.40, 0.58, -0.08], "tags": ["hidden"],
      "contents": ["twilight"] }
  ],

  "phases": [
    {
      "key": "origin", "type": "draw_and_play", "label": "Origin",
      "deck": "origins", "draw": 3, "pass_card": "decline",
      "next": [ { "then": "market_visit", "ends_round": true } ]
    },
    {
      "key": "market_visit", "type": "player_input", "label": "The Market",
      "deck": "market_deck", "draw": 4,
      "pass_card": ["to_market", "to_barracks", "to_sanctum"],
      "next": [
        { "stat": "progress",    "at_least": 10, "then": "trial_gate",     "ends_round": true },
        { "stat": "round",       "at_least": 7,  "then": "trial_gate",     "ends_round": true },
        { "stat": "destination", "equals": 2,    "then": "barracks_visit", "ends_round": true },
        { "stat": "destination", "equals": 3,    "then": "sanctum_visit",  "ends_round": true },
        { "then": "market_visit", "ends_round": true }
      ]
    },
    {
      "key": "barracks_visit", "type": "player_input", "label": "The Barracks",
      "deck": "barracks_deck", "draw": 4,
      "pass_card": ["to_market", "to_barracks", "to_sanctum"],
      "next": [
        { "stat": "progress",    "at_least": 10, "then": "trial_gate",    "ends_round": true },
        { "stat": "round",       "at_least": 7,  "then": "trial_gate",    "ends_round": true },
        { "stat": "destination", "equals": 1,    "then": "market_visit",  "ends_round": true },
        { "stat": "destination", "equals": 3,    "then": "sanctum_visit", "ends_round": true },
        { "then": "barracks_visit", "ends_round": true }
      ]
    },
    {
      "key": "sanctum_visit", "type": "player_input", "label": "The Sanctum",
      "deck": "sanctum_deck", "draw": 4,
      "pass_card": ["to_market", "to_barracks", "to_sanctum"],
      "next": [
        { "stat": "progress",    "at_least": 10, "then": "trial_gate",     "ends_round": true },
        { "stat": "round",       "at_least": 7,  "then": "trial_gate",     "ends_round": true },
        { "stat": "destination", "equals": 1,    "then": "market_visit",   "ends_round": true },
        { "stat": "destination", "equals": 2,    "then": "barracks_visit", "ends_round": true },
        { "then": "sanctum_visit", "ends_round": true }
      ]
    },
    {
      "key": "trial_gate", "type": "automatic",
      "actions": ["return_to:hand:graveyard"],
      "next": [
        { "stat": "progress", "at_least": 20, "then": "trial3" },
        { "stat": "progress", "at_least": 14, "then": "trial2" },
        { "then": "trial1" }
      ]
    },
    {
      "key": "trial1", "type": "player_input", "label": "Trials I",
      "deck": "trials1", "draw": 2, "pass_card": "rest",
      "next": [ { "then": "trial_gate", "ends_round": true } ]
    },
    {
      "key": "trial2", "type": "player_input", "label": "Trials II",
      "deck": "trials2", "draw": 2, "pass_card": "rest",
      "next": [ { "then": "trial_gate", "ends_round": true } ]
    },
    {
      "key": "trial3", "type": "player_input", "label": "Trials III",
      "deck": "trials3", "draw": 2, "pass_card": "rest",
      "next": [ { "then": "trial_gate", "ends_round": true } ]
    },
    {
      "key": "coronation", "type": "overlay", "label": "Coronation",
      "deck": "fate_crown", "zone": "offer", "draw": 1,
      "on_pick": ["load_game:menu.json"]
    },
    {
      "key": "collapse", "type": "overlay", "label": "The Fall",
      "deck": "fate_ruin", "zone": "offer", "draw": 1,
      "on_pick": ["load_game:menu.json"]
    },
    {
      "key": "twilight_years", "type": "overlay", "label": "Twilight Years",
      "deck": "fate_twilight", "zone": "offer", "draw": 1,
      "on_pick": ["load_game:menu.json"]
    }
  ],

  "end_conditions": [
    { "stat": "stability", "at_most": 0,  "then": ["push_phase:collapse"] },
    { "stat": "progress", "at_least": 24, "then": ["push_phase:coronation"] },
    { "stat": "round",    "at_least": 20, "then": ["push_phase:twilight_years"] }
  ]
}
