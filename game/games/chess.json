{
  "title": "Chess",
  "players": [{ "card": "player_white" }, { "card": "player_black" }],
  "assets": {
    "pawn": { "src": ["Chess_plt60.png", "Chess_pdt60.png"] },
    "rook": { "src": ["Chess_rlt60.png", "Chess_rdt60.png"] },
    "knight": { "src": ["Chess_nlt60.png", "Chess_ndt60.png"] },
    "bishop": { "src": ["Chess_blt60.png", "Chess_bdt60.png"] },
    "queen": { "src": ["Chess_qlt60.png", "Chess_qdt60.png"] },
    "king": { "src": ["Chess_klt60.png", "Chess_kdt60.png"] },
    "castle_button": { "src": ["Chess_klt60.png", "Chess_kdt60.png"] }
  },
  "styles": {
    "piece": { "title": false, "color": false, "border": false },
    "chessboard": { "fit": "fill", "ratio": "grid", "chequer": ["#f0d9b5", "#b58863"], "cell_outline": false }
  },
  "patterns": {
    "line_ortho": { "vectors": [[1, 0], [0, 1]], "class": ["ray", "mirrored"] },
    "line_diag": { "vectors": [[1, 1]], "class": ["ray", "mirrored"] },
    "adjacent": { "vectors": [[1, 0], [0, 1], [1, 1]], "class": ["step", "mirrored"] },
    "knight_leap": { "vectors": [[1, 2], [2, 1]], "class": ["step", "mirrored"] },
    "pawn_step": { "vectors": [[0, 1]], "class": ["step"] },
    "pawn_run": { "vectors": [[0, 1]], "class": ["ray:2"] },
    "pawn_take": { "vectors": [[1, 1], [-1, 1]], "class": ["step"] },
    "w_castle_q_path": { "vectors": [[2, 8], [3, 8], [4, 8]], "class": ["absolute"], "zone": "board" },
    "w_castle_k_path": { "vectors": [[6, 8], [7, 8]], "class": ["absolute"], "zone": "board" },
    "b_castle_q_path": { "vectors": [[2, 1], [3, 1], [4, 1]], "class": ["absolute"], "zone": "board" },
    "b_castle_k_path": { "vectors": [[6, 1], [7, 1]], "class": ["absolute"], "zone": "board" },
    "w_king_home": { "vectors": [[5, 8]], "class": ["absolute"], "zone": "board" },
    "w_rook_a_home": { "vectors": [[1, 8]], "class": ["absolute"], "zone": "board" },
    "w_rook_h_home": { "vectors": [[8, 8]], "class": ["absolute"], "zone": "board" },
    "b_king_home": { "vectors": [[5, 1]], "class": ["absolute"], "zone": "board" },
    "b_rook_a_home": { "vectors": [[1, 1]], "class": ["absolute"], "zone": "board" },
    "b_rook_h_home": { "vectors": [[8, 1]], "class": ["absolute"], "zone": "board" }
  },
  "zones": [
    {
      "key": "board",
      "type": "grid",
      "grid": [8, 8],
      "pos": [0.28, 0.03, 0.72, 0.97],
      "tags": ["activate", "chessboard"]
    },
    {
      "key": "taken",
      "type": "pile",
      "tags": ["per_seat"],
      "pos": [[0.76, 0.65, 0.97, 0.95], [0.76, 0.05, 0.97, 0.35]]
    },
    {
      "key": "b_options",
      "type": "hand",
      "tags": ["optional"],
      "pos": [0.76, 0.36, 0.97, 0.44]
    },
    { "key": "rules", "type": "pile", "pos": [0.76, 0.45, 0.97, 0.55] },
    {
      "key": "w_options",
      "type": "hand",
      "tags": ["optional"],
      "pos": [0.76, 0.56, 0.97, 0.64]
    }
  ],
  "phases": [
    {
      "key": "white_move",
      "type": "player_input",
      "label": "White to move",
      "seat": "next",
      "next": [
        { "stat": "count:king@mine.reach", "at_least": 1, "then": "black_check" },
        { "then": "black_move" }
      ]
    },
    {
      "key": "black_check",
      "type": "player_input",
      "label": "Black to move — in check",
      "seat": "next",
      "next": [
        { "stat": "count:king@mine.reach", "at_least": 1, "then": "white_check" },
        { "then": "white_move" }
      ]
    },
    {
      "key": "black_move",
      "type": "player_input",
      "label": "Black to move",
      "seat": "next",
      "next": [
        { "stat": "count:king@mine.reach", "at_least": 1, "then": "white_check" },
        { "then": "white_move" }
      ]
    },
    {
      "key": "white_check",
      "type": "player_input",
      "label": "White to move — in check",
      "seat": "next",
      "next": [
        { "stat": "count:king@mine.reach", "at_least": 1, "then": "black_check" },
        { "then": "black_move" }
      ]
    }
  ],
  "end_conditions": [{ "stat": "count:king@taken", "at_least": 1, "then": ["load_game:menu.json"] }],
  "setup": {
    "place": [
      { "card": "rook", "owner": "player_white", "zone": "board", "at": ["a1", "h1"] },
      { "card": "knight", "owner": "player_white", "zone": "board", "at": ["b1", "g1"] },
      { "card": "bishop", "owner": "player_white", "zone": "board", "at": ["c1", "f1"] },
      { "card": "queen", "owner": "player_white", "zone": "board", "at": ["d1"] },
      { "card": "king", "owner": "player_white", "zone": "board", "at": ["e1"] },
      {
        "card": "pawn",
        "owner": "player_white",
        "zone": "board",
        "at": ["a2", "b2", "c2", "d2", "e2", "f2", "g2", "h2"]
      },
      { "card": "rook", "owner": "player_black", "zone": "board", "at": ["a8", "h8"] },
      { "card": "knight", "owner": "player_black", "zone": "board", "at": ["b8", "g8"] },
      { "card": "bishop", "owner": "player_black", "zone": "board", "at": ["c8", "f8"] },
      { "card": "queen", "owner": "player_black", "zone": "board", "at": ["d8"] },
      { "card": "king", "owner": "player_black", "zone": "board", "at": ["e8"] },
      {
        "card": "pawn",
        "owner": "player_black",
        "zone": "board",
        "at": ["a7", "b7", "c7", "d7", "e7", "f7", "g7", "h7"]
      },
      { "card": "w_castle_q", "owner": "player_white", "zone": "w_options" },
      { "card": "w_castle_k", "owner": "player_white", "zone": "w_options" },
      { "card": "b_castle_q", "owner": "player_black", "zone": "b_options" },
      { "card": "b_castle_k", "owner": "player_black", "zone": "b_options" },
      { "card": "how_to_play", "zone": "rules" }
    ]
  },
  "cards": [
    { "key": "player_white", "text": "White" },
    { "key": "player_black", "text": "Black" },
    {
      "key": "pawn",
      "text": "Pawn",
      "asset": "pawn",
      "tooltip": "One square forward, two from its home rank, and it takes diagonally.",
      "tags": ["piece", "pawn", "stays_ready"],
      "card_stats": { "rank": 0, "moves_made": 0 },
      "activate": {
        "moves": [
          { "patterns": ["pawn_step"], "fill": "empty" },
          {
            "patterns": ["pawn_run"],
            "fill": "empty",
            "needs": { "rank@self": { "equals": 2 } }
          },
          { "patterns": ["pawn_take"], "fill": "enemy" }
        ],
        "action": ["move_to:target:taken", "gain_stat:moves_made@self:1", "next_phase"]
      }
    },
    {
      "key": "rook",
      "text": "Rook",
      "asset": "rook",
      "tooltip": "Any distance along a rank or a file.",
      "tags": ["piece", "rook", "stays_ready"],
      "card_stats": { "rank": 0, "moves_made": 0 },
      "activate": {
        "moves": ["line_ortho"],
        "action": ["move_to:target:taken", "gain_stat:moves_made@self:1", "next_phase"]
      }
    },
    {
      "key": "knight",
      "text": "Knight",
      "asset": "knight",
      "tooltip": "An L, and the only piece that leaps what stands in the way.",
      "tags": ["piece", "knight", "stays_ready"],
      "card_stats": { "rank": 0, "moves_made": 0 },
      "activate": {
        "moves": ["knight_leap"],
        "action": ["move_to:target:taken", "gain_stat:moves_made@self:1", "next_phase"]
      }
    },
    {
      "key": "bishop",
      "text": "Bishop",
      "asset": "bishop",
      "tooltip": "Any distance along a diagonal, so it never leaves its colour.",
      "tags": ["piece", "bishop", "stays_ready"],
      "card_stats": { "rank": 0, "moves_made": 0 },
      "activate": {
        "moves": ["line_diag"],
        "action": ["move_to:target:taken", "gain_stat:moves_made@self:1", "next_phase"]
      }
    },
    {
      "key": "queen",
      "text": "Queen",
      "asset": "queen",
      "tooltip": "Any distance in any of the eight directions.",
      "tags": ["piece", "queen", "stays_ready"],
      "card_stats": { "rank": 0, "moves_made": 0 },
      "activate": {
        "moves": ["line_ortho", "line_diag"],
        "action": ["move_to:target:taken", "gain_stat:moves_made@self:1", "next_phase"]
      }
    },
    {
      "key": "king",
      "text": "King",
      "asset": "king",
      "tooltip": "One square in any direction. Lose it and the game is over.",
      "tags": ["piece", "king", "stays_ready"],
      "card_stats": { "rank": 0, "moves_made": 0 },
      "activate": {
        "moves": ["adjacent"],
        "action": ["move_to:target:taken", "gain_stat:moves_made@self:1", "next_phase"]
      }
    },
    {
      "key": "w_castle_q",
      "text": "Castle queenside",
      "tooltip": "King and rook both still unmoved, and the squares between them empty. The king moves two toward the rook; the rook hops to its far side. Counts as your move.",
      "asset": "castle_button",
      "tags": ["castling"],
      "play": {
        "needs": {
          "count:king@w_king_home": { "equals": 1 },
          "moves_made@w_king_home": { "equals": 0 },
          "count:rook@w_rook_a_home": { "equals": 1 },
          "moves_made@w_rook_a_home": { "equals": 0 },
          "count:piece@w_castle_q_path": { "equals": 0 }
        },
        "action": [
          "gain_stat:moves_made@w_king_home:1",
          "place:w_king_home:3:8",
          "place:w_rook_a_home:4:8",
          "next_phase"
        ]
      }
    },
    {
      "key": "w_castle_k",
      "text": "Castle kingside",
      "tooltip": "King and rook both still unmoved, and the squares between them empty. The king moves two toward the rook; the rook hops to its far side. Counts as your move.",
      "asset": "castle_button",
      "tags": ["castling"],
      "play": {
        "needs": {
          "count:king@w_king_home": { "equals": 1 },
          "moves_made@w_king_home": { "equals": 0 },
          "count:rook@w_rook_h_home": { "equals": 1 },
          "moves_made@w_rook_h_home": { "equals": 0 },
          "count:piece@w_castle_k_path": { "equals": 0 }
        },
        "action": [
          "gain_stat:moves_made@w_king_home:1",
          "place:w_king_home:7:8",
          "place:w_rook_h_home:6:8",
          "next_phase"
        ]
      }
    },
    {
      "key": "b_castle_q",
      "text": "Castle queenside",
      "tooltip": "King and rook both still unmoved, and the squares between them empty. The king moves two toward the rook; the rook hops to its far side. Counts as your move.",
      "asset": "castle_button",
      "tags": ["castling"],
      "play": {
        "needs": {
          "count:king@b_king_home": { "equals": 1 },
          "moves_made@b_king_home": { "equals": 0 },
          "count:rook@b_rook_a_home": { "equals": 1 },
          "moves_made@b_rook_a_home": { "equals": 0 },
          "count:piece@b_castle_q_path": { "equals": 0 }
        },
        "action": [
          "gain_stat:moves_made@b_king_home:1",
          "place:b_king_home:3:1",
          "place:b_rook_a_home:4:1",
          "next_phase"
        ]
      }
    },
    {
      "key": "b_castle_k",
      "text": "Castle kingside",
      "tooltip": "King and rook both still unmoved, and the squares between them empty. The king moves two toward the rook; the rook hops to its far side. Counts as your move.",
      "asset": "castle_button",
      "tags": ["castling"],
      "play": {
        "needs": {
          "count:king@b_king_home": { "equals": 1 },
          "moves_made@b_king_home": { "equals": 0 },
          "count:rook@b_rook_h_home": { "equals": 1 },
          "moves_made@b_rook_h_home": { "equals": 0 },
          "count:piece@b_castle_k_path": { "equals": 0 }
        },
        "action": [
          "gain_stat:moves_made@b_king_home:1",
          "place:b_king_home:7:1",
          "place:b_rook_h_home:6:1",
          "next_phase"
        ]
      }
    },
    {
      "key": "how_to_play",
      "text": "How to play",
      "tags": ["immutable"],
      "play": { "phases": [] },
      "tooltip": "Click one of your pieces to light up the squares it can reach, then click a square to move. Click an enemy piece to take it — its square lights up too.\n\nCastling: the two buttons beside your graveyard. Needs king and rook both unmoved, and the squares between them empty.\n\nNot implemented yet:\n- Checkmate. Check is shown — the phase says \"in check\" — but nothing stops you moving into check, leaving one, or castling through it, and you win by capturing the king rather than by trapping it.\n- En passant.\n- Pawn promotion. A pawn reaching the far rank just stops there.\n- Draws: stalemate, threefold repetition, the fifty-move rule.\n- Resigning and offering a draw."
    }
  ]
}
