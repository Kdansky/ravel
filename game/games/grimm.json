        { "key": "divide", "compute": ["split_straw"],
          "needs": ["count:pig@fields >= 1"],
          "action": ["stat_set:share@self:split_straw"] },
        { "key": "spend",
          "action": ["stat_damage:pool@self:sum:share@self:x:count:pig@fields"] },
        { "key": "clear", "action": ["stat_set:share@self:0"] },
        { "key": "replenish", "action": ["stat_gain:pool@self:5"] }
      ] },
    { "key": "forest_board", "text": "Forest", "tags": ["location", "at_forest", "ground", "plate_wood", "immutable"],
      "asset": "forest_board",
      "card_stats": { "pool": 4 },
