    { "key": "green", "text": "Green", "tags": ["green_side"], "asset": "circle:green",
      "card_stats": { "seat_no": 2, "turnpos": 2 },
      "abilities": [
        { "key": "rotate", "compute": ["my_place"], "action": ["stat_set:turnpos@self:my_place"] },
        { "key": "judge", "compute": ["tally"], "action": ["stat_set:final@self:tally"] },
        { "key": "crown", "needs": ["final@self >= max:final@anyone.player"], "action": ["stat_gain:won@self:1"] },
        { "key": "build_start", "needs": ["searching@self >= 1"],
          "action": ["stat_set:searching@self:0", "show:fable_discard", "show:fable_discard"] }
      ],
      "chosen": { "action": ["move:target:mine.fables"] } },

    { "key": "pig", "text": "Pig", "tags": ["pig", "piece"],
      "asset": "pig",
      "tooltip": "Your pig. It walks to the Location your Gather card names, and what it finds there is shared with every other pig that walked to the same place." },

    { "key": "fields_board", "text": "Fields", "tags": ["location", "at_fields", "ground", "plate_straw", "immutable"],
      "asset": "fields_board",
