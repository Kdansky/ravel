    { "key": "pool", "label": "Lying there", "icon": "none", "min": 0, "max": 99, "display": "offscreen", "on": ["location"], "start": 0 },
    { "key": "share", "min": 0, "max": 99, "display": "offscreen", "on": ["location"], "start": 0 },

    { "key": "level", "label": "Built", "icon": "none", "min": 0, "max": 3, "display": "offscreen", "on": ["house"], "start": 1 },
    { "key": "stock", "icon": "none", "min": 0, "max": 99, "display": "offscreen" }
  ],

  "computed_tags": {
    "wip_straw": { "needs": ["tagged:straw_h@self", "level@self <= 2"] },
    "wip_wood": { "needs": ["tagged:wood_h@self", "level@self <= 2"] },
    "wip_brick": { "needs": ["tagged:brick_h@self", "level@self <= 2"] }
  },

  "tags": {
    "fable": {
