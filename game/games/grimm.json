    { "key": "fables", "label": "Fables", "layout": "row", "visibility": "owner", "copies": "per_seat",
      "pos": [[0.795, 0.695, 0.995, 0.995], [0.795, 0.005, 0.995, 0.145], [0.795, 0.150, 0.995, 0.290]] }
  ],

  "phases": [
    { "key": "opening", "type": "automatic", "next": [{ "then": "plan" }] },

    { "key": "plan", "type": "turn", "seat": "each", "order": "lowest:turnpos",
      "phases": ["pick_gather", "pick_fable"], "next": [{ "then": "walk_out" }] },

    { "key": "pick_gather", "type": "player_input", "zone": "plan",
      "label": "Choose where to gather — face down",
      "ends_when": "count@mine.commit >= 1" },

    { "key": "pick_fable", "type": "player_input", "zone": "fables", "pass_card": "no_fable",
      "label": "Play a Fable with it, or none" },

    { "key": "walk_out", "type": "automatic", "label": "The pigs set out",
      "actions": ["each_seat:activate_zone:mine.commit:by_column:go",
                  "each_seat:activate_zone:mine.commit:by_column:crowd"],
      "next": [{ "then": "boost" }] },

    { "key": "boost", "type": "automatic", "label": "Before collecting",
      "actions": ["each_seat:activate_zone:mine.friend:by_column:after_reveal",
                  "each_seat:activate_zone:mine.commit:by_column:pre"],
      "next": [{ "then": "divide" }] },

    { "key": "divide", "type": "automatic",
      "actions": ["activate_zone:locations:by_column:divide"],
      "next": [{ "then": "collect" }] },

    { "key": "collect", "type": "automatic", "label": "Sharing what is there",
      "actions": ["each_seat:activate_zone:mine.commit:by_column:collect",
                  "activate_zone:locations:by_column:spend"],
      "next": [{ "then": "end_gather" }] },

    { "key": "end_gather", "type": "automatic", "label": "End of the Gather phase",
      "actions": ["each_seat:activate_zone:mine.friend:by_column:end_gather",
                  "each_seat:activate_zone:mine.commit:by_column:end_gather"],
      "next": [{ "then": "late_places" }] },

    { "key": "late_places", "type": "automatic",
      "actions": ["each_seat:activate_zone:mine.commit:by_column:vault",
                  "each_seat:activate_zone:mine.commit:by_column:bully"],
      "next": [{ "then": "gather_done" }] },

    { "key": "gather_done", "type": "automatic",
      "actions": ["activate_zone:locations:by_column:clear",
                  "each_seat:move:mine.commit.gather:mine.plan",
                  "each_seat:move:mine.commit.fable:fable_discard"],
      "next": [{ "then": "build" }] },

    { "key": "build", "type": "turn", "seat": "each", "order": "lowest:turnpos",
      "phases": ["build_turn"],
      "next": [{ "when": "max:houses@anyone.player >= 3", "then": "judging" },
               { "then": "cleanup" }] },

    { "key": "build_turn", "type": "player_input", "zone": ["tools", "sites", "friend"],
      "label": "Two actions: a Fable, a resource, or build",
      "actions": ["stat_set:acts@mine.player:2",
                  "stat_gain:acts@mine.player:sum:extra_acts@mine.player",
                  "stat_damage:acts@mine.player:sum:dock@mine.player",
                  "stat_set:extra_acts@mine.player:0",
                  "stat_set:dock@mine.player:0",
                  "ready:mine.friend",
                  "activate_zone:mine.friend:by_column:build_start",
                  "activate_zone:mine.seat_box:by_column:build_start"],
      "ends_when": "acts@mine.player == 0" },

    { "key": "cleanup", "type": "automatic", "label": "Clean up",
      "actions": ["move:anyone.pig:origin",
                  "activate_zone:locations:by_column:replenish",
                  "stat_set:gathered@each.anyone.player:0",
                  "stat_set:crowd@each.anyone.player:0",
                  "stat_set:mates@each.anyone.player:0",
                  "stat_set:bully@each.anyone.player:0",
                  "stat_set:vaulting@each.anyone.player:0",
                  "stat_set:beanstalk@each.anyone.player:0",
                  "stat_gain:rnd@each.anyone.player:1",
                  "each_seat:activate_zone:mine.seat_box:by_column:rotate"],
      "next": [{ "then": "plan", "ends_round": true }] },

    { "key": "judging", "type": "automatic",
      "actions": ["each_seat:activate_zone:mine.seat_box:by_column:judge"],
      "next": [{ "then": "crowning" }] },

    { "key": "crowning", "type": "automatic",
      "actions": ["each_seat:activate_zone:mine.seat_box:by_column:crown"],
      "next": [{ "when": ["final@orange_side >= final@blue_side", "final@orange_side >= final@green_side"],
                 "then": "orange_won" },
               { "when": "final@blue_side >= final@green_side", "then": "blue_won" },
               { "then": "green_won" }] },

    { "key": "orange_won", "type": "automatic", "actions": ["reveal:orange_wins"], "next": [{ "then": "over" }] },
    { "key": "blue_won", "type": "automatic", "actions": ["reveal:blue_wins"], "next": [{ "then": "over" }] },
    { "key": "green_won", "type": "automatic", "actions": ["reveal:green_wins"], "next": [{ "then": "over" }] },

    { "key": "over", "type": "player_input", "label": "The contest is over", "next": [{ "then": "over" }] }
  ],

  "end_conditions": [],

  "setup": {
    "place": [
      { "card": "orange", "zone": "seat_box" },
      { "card": "blue", "zone": "seat_box" },
      { "card": "green", "zone": "seat_box" },
      { "card": "pig", "zone": "pen" },

      { "card": "fields_board", "zone": "locations", "at": "a1" },
      { "card": "forest_board", "zone": "locations", "at": "b1" },
      { "card": "brickyard_board", "zone": "locations", "at": "c1" },

      { "card": "fb_straw", "zone": "bonuses" },
      { "card": "fb_wood", "zone": "bonuses" },
      { "card": "fb_brick", "zone": "bonuses" },

      { "card": "g_fields", "zone": "plan" },
      { "card": "g_forest", "zone": "plan" },
      { "card": "g_brickyard", "zone": "plan" },

      { "card": "draw_fable", "zone": "tools" },
      { "card": "gain_straw", "zone": "tools" },
      { "card": "gain_wood", "zone": "tools" },
      { "card": "gain_brick", "zone": "tools" },
      { "card": "start_straw", "zone": "tools" },
      { "card": "start_wood", "zone": "tools" },
      { "card": "start_brick", "zone": "tools" },

      { "card": "not_implemented", "zone": "rules" }
    ]
  },

  "cards": [
    { "key": "orange", "text": "Orange", "tags": ["orange_side"], "asset": "circle:orange",
      "card_stats": { "seat_no": 0, "turnpos": 0 },
      "abilities": [
        { "key": "rotate", "compute": ["my_place"], "action": ["stat_set:turnpos@self:my_place"] },
        { "key": "judge", "compute": ["tally"], "action": ["stat_set:final@self:tally"] },
        { "key": "crown", "needs": ["final@self >= max:final@anyone.player"], "action": ["stat_gain:won@self:1"] },
