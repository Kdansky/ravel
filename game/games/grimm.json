  "computes": [
    { "key": "split_straw", "value": "pool@self / count:pig@fields",
      "tooltip": "What one pig standing in the Fields takes: the pile divided by the pigs, rounded down." },
    { "key": "split_wood", "value": "pool@self / count:pig@forest",
      "tooltip": "What one pig standing in the Forest takes." },
    { "key": "split_brick", "value": "pool@self / count:pig@brickyard",
      "tooltip": "What one pig standing in the Brickyard takes." },
    { "key": "my_place", "value": "(seat_no@self - rnd@self) % 3",
      "tooltip": "Where this seat sits in the order this round. The Starting Player marker passing clockwise is this number going down by one." },
    { "key": "tally", "value": "(houses@self * 1000) + (hb_brick@self * 100) + (hb_wood@self * 10) + tok_brick@self",
      "tooltip": "Houses first, then Brick houses, then Wood houses, then the Brick First Builder token — the tie-breakers in the order the rulebook gives them." }
  ],

