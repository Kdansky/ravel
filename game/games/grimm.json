  "styles": {
    "plate_straw": { "color": [0.85, 0.74, 0.38] },
    "plate_wood": { "color": [0.47, 0.33, 0.20] },
    "plate_brick": { "color": [0.66, 0.27, 0.22] },
    "plate_fable": { "color": [0.30, 0.26, 0.40] },
    "plate_friend": { "color": [0.24, 0.45, 0.42] },
    "plate_token": { "color": [0.72, 0.60, 0.24] },
