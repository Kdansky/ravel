  "stats": [{ "key": "hp", "min": 0, "max": 10, "label": "Health" }],
  "phases": [
    { "key": "setup", "type": "automatic", "actions": ["draw_from:road:hand:1"] },
    { "key": "journey", "type": "player_input", "label": "The Journey" },
    {
      "key": "path_choice",
      "type": "overlay",
      "label": "Choose your path",
      "deck": "paths",
      "zone": "offer",
      "draw": 3
    },
    {
      "key": "victory",
      "type": "overlay",
      "label": "Journey's End",
      "deck": "fate_victory",
      "zone": "victory_offer",
      "draw": 1
    },
    {
      "key": "defeat",
      "type": "overlay",
      "label": "You Perished",
      "deck": "fate_defeat",
      "zone": "defeat_offer",
      "draw": 1
    }
  ],
  "end_conditions": [
    { "stat": "hp", "equals": 0, "then": ["push_phase:defeat"] },
    { "zone_empty": ["road", "hand"], "then": ["push_phase:victory"] }
  ],
  "tags": { "path_choice_pick": { "play": { "action": ["add_to:hand", "return_to:offer:paths"] } } }
