  "cards": [
    {
      "key": "shelter",
      "text": "Find Shelter",
      "asset": "shelter.png",
      "tooltip": "You find an abandoned cottage and rest inside. Recover 1 health.",
      "play": { "action": ["stat_gain:hp:1", "move_to:past", "draw_from:road:hand:1"] }
    },
    {
      "key": "storm",
      "text": "Storm",
      "asset": "storm.png",
      "tooltip": "A sudden storm rolls in. You lose 1 health pushing through.",
      "play": { "action": ["stat_damage:hp:1", "move_to:past", "draw_from:road:hand:1"] }
    },
    {
      "key": "stranger",
      "text": "Stranger",
      "asset": "stranger.png",
      "tooltip": "A kind traveler shares their food with you. Gain 1 health.",
      "play": { "action": ["stat_gain:hp:1", "move_to:past", "draw_from:road:hand:1"] }
    },
    {
      "key": "bandits",
      "text": "Bandits",
      "asset": "bandits.png",
      "tooltip": "Ambushed on the road. You escape, but not unscathed. Lose 2 health.",
      "play": { "action": ["stat_damage:hp:2", "move_to:past", "draw_from:road:hand:1"] }
    },
    {
      "key": "village",
      "text": "Village",
      "asset": "village.png",
      "tooltip": "A warm welcome in a friendly village. Rest well and gain 2 health.",
      "play": { "action": ["stat_gain:hp:2", "move_to:past", "draw_from:road:hand:1"] }
    },
    {
      "key": "ruins",
      "text": "Ancient Ruins",
      "asset": "ruins.jpg",
      "tooltip": "Crumbling walls hide old dangers. Lose 1 health picking through the rubble.",
      "play": { "action": ["stat_damage:hp:1", "move_to:past", "draw_from:road:hand:1"] }
    },
    {
      "key": "crossroads",
      "text": "Crossroads",
      "asset": "world.jpg",
      "tooltip": "The road forks. Choose your path.",
      "play": { "action": ["move_to:past", "push_phase:path_choice"] }
    },
    {
      "key": "mountain_pass",
      "text": "Mountain Pass",
      "asset": "ruins.jpg",
      "tooltip": "Steep and cold, but short. Lose 1 health.",
      "play": { "action": ["stat_damage:hp:1", "move_to:past", "draw_from:road:hand:1"] }
    },
    {
      "key": "forest_trail",
      "text": "Forest Trail",
      "asset": "shelter.png",
      "tooltip": "The long way around, but nothing troubles you.",
      "play": { "action": ["move_to:past", "draw_from:road:hand:1"] }
    },
    {
      "key": "old_bridge",
      "text": "Old Bridge",
      "asset": "stone_bridge.jpg",
      "tooltip": "It creaks but holds, and you rest on the far bank. Gain 1 health.",
      "play": { "action": ["stat_gain:hp:1", "move_to:past", "draw_from:road:hand:1"] }
    },
    {
      "key": "journeys_end",
      "outcome": "victory",
      "text": "Journey's End",
      "asset": "village.png",
      "tooltip": "You survived the wandering road. Click to return to the menu.",
      "play": { "action": ["load_game:menu.json"] }
    },
    {
      "key": "perished",
      "outcome": "defeat",
      "text": "You Perished",
      "asset": "storm.png",
      "tooltip": "The road has claimed you. Click to return to the menu.",
      "play": { "action": ["load_game:menu.json"] }
    }
