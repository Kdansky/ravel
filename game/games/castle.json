{
  "title": "Castle Lord",
  "effects": { "festival_lights": { "base": "sparkle", "count": 1.6 } },
  "stats": [
    { "key": "hp", "icon": "heart", "min": 0, "tags": ["hidden"] },
    { "key": "round", "label": "Round" },
    { "key": "gold", "label": "Gold", "icon": "coin", "min": 0, "max": 999 },
    { "key": "morale", "label": "Morale", "icon": "banner", "min": 0, "max": 10 },
    {
      "key": "defense",
      "label": "Defense",
      "icon": "shield",
      "min": 0,
      "max": 999,
      "subject": "sum:defense@standing"
    },
    { "key": "food", "label": "Food", "icon": "leaf", "min": 0, "max": 999 }
  ],
  "computed_tags": {
    "damaged": { "stat": "hp", "less_than_max": true },
    "standing": { "stat": "hp", "at_least": 1 }
  },
  "styles": { "slate": { "color": [0.1, 0.14, 0.22] }, "tiled": { "fit": "fill" } },
  "setup": { "place": [{ "card": "throne_room", "zone": "board", "at": "c3" }] },
  "players": [{ "card": "throne_room" }],
  "cards": [
    {
      "key": "throne_room",
      "text": "Throne Room",
      "asset": "castle_hill.jpg",
      "tooltip": "Your seat of power. Taxes bring 1 gold each round. Pay 2 gold to inspire your people (+1 morale).",
      "card_stats": { "hp": { "value": 20, "max": 20 }, "gold": 20, "morale": 5, "defense": 0, "food": 0 },
      "tags": ["building", "hero"],
      "activate": { "cost": { "exhaust": 1, "gold": 2 }, "action": ["stat_gain:morale:1"] },
      "turn": { "action": ["stat_gain:gold:1"] }
    },
    {
      "key": "watchtower",
      "text": "Watchtower",
      "asset": "fortress_walls.jpg",
      "tooltip": "A guard post on the walls. Adds 2 defense while it stands.",
      "play": {
        "cost": { "gold": 2 },
        "target": { "type": "slot", "min": 1, "max": 1, "zones": ["board"] },
        "action": ["move_to:board"]
      },
      "card_stats": { "hp": { "value": 4, "max": 4 }, "defense": 2 },
      "tags": ["building", "military"]
    },
    {
      "key": "farm",
      "text": "Farm",
      "asset": "farmhouse_fields.jpg",
      "tooltip": "Feeds your people: +1 food each round.",
      "play": {
        "cost": { "gold": 1 },
        "target": { "type": "slot", "min": 1, "max": 1, "zones": ["board"] },
        "action": ["move_to:board"]
      },
      "turn": { "action": ["stat_gain:food:1"] },
      "card_stats": { "hp": { "value": 3, "max": 3 } },
      "tags": ["building", "economic"]
    },
    {
      "key": "market",
      "text": "Market",
      "asset": "market_square.jpg",
      "tooltip": "Trade routes bring +1 gold each round.",
      "play": {
        "cost": { "gold": 2 },
        "target": { "type": "slot", "min": 1, "max": 1, "zones": ["board"] },
        "action": ["move_to:board"]
      },
      "turn": { "action": ["stat_gain:gold:1"] },
      "card_stats": { "hp": { "value": 3, "max": 3 } },
      "tags": ["building", "economic"]
    },
    {
      "key": "repair",
      "text": "Repair Crew",
      "asset": "blacksmith_forge.jpg",
      "tooltip": "Restore 2 HP to a damaged building.",
      "play": {
        "cost": { "gold": 1 },
        "target": {
          "type": "card",
          "min": 0,
          "max": 1,
          "tags": ["building", "damaged"],
          "zones": ["board"]
        },
        "action": ["stat_gain:hp@target:2", "move_to:graveyard"]
      },
      "tags": ["one_shot"]
    },
    {
      "key": "mercenaries",
      "text": "Mercenaries",
      "asset": "army_camp.jpg",
      "tooltip": "Hired swords. +3 defense.",
      "play": { "cost": { "gold": 2 }, "action": ["stat_gain:defense:3", "move_to:graveyard"] },
      "tags": ["one_shot"]
    },
    {
      "key": "architect",
      "text": "Architect",
      "asset": "stranger.png",
      "tooltip": "Commission a building: pick 1 of 3 from the build deck.",
      "play": { "cost": { "gold": 1 }, "action": ["move_to:graveyard", "push_phase:draft"] },
      "tags": ["one_shot"]
    },
    {
      "key": "pass",
      "text": "Pass",
      "tooltip": "Bide your time. Nothing happens this phase.",
      "tags": ["token", "slate"],
      "play": { "action": ["destroy_self"] }
    },
    {
      "key": "royal_decree",
      "text": "Royal Decree",
      "asset": "crown_royal.jpg",
      "tooltip": "The court awaits your word. Choose one of three edicts.",
      "play": { "cost": { "gold": 2 }, "action": ["move_to:graveyard", "push_phase:decree"] },
      "tags": ["one_shot"]
    },
    {
      "key": "festival",
      "text": "Festival",
      "asset": "tavern_meal.jpg",
      "tooltip": "A feast for the whole town costs 2 gold. Gain 2 morale.",
      "play": {
        "cost": { "gold": 2 },
        "action": ["effect:festival_lights", "stat_gain:morale:2", "move_to:edicts"]
      },
      "tags": ["one_shot", "edict"]
    },
    {
      "key": "conscription",
      "text": "Conscription",
      "asset": "marching_column.jpg",
      "tooltip": "Every able hand takes up arms. Gain 3 defense.",
      "tags": ["one_shot", "edict"],
      "play": { "action": ["stat_gain:defense:3", "move_to:edicts"] }
    },
    {
      "key": "tax_levy",
      "text": "Tax Levy",
      "asset": "money_lender.jpg",
      "tooltip": "The coffers fill, the people grumble. Gain 3 gold.",
      "tags": ["one_shot", "edict"],
      "play": { "action": ["stat_gain:gold:3", "move_to:edicts"] }
    },
    {
      "key": "bandit_raid",
      "text": "Bandit Raid",
      "asset": "cavalry_raid.jpg",
      "tooltip": "Raiders attack! Need 3 defense or lose 2 morale.",
      "tags": ["challenge"],
      "challenge": { "needs": ["sum:defense@standing >= 3"], "pass": [], "fail": ["stat_damage:morale:2"] },
      "play": { "action": ["move_to:graveyard", "resolve_challenge"] }
    },
    {
      "key": "drought",
      "text": "Drought",
      "asset": "blighted_tree.jpg",
      "tooltip": "Crops wither. Need 3 food or lose 1 morale.",
      "tags": ["challenge"],
      "challenge": { "needs": ["food >= 3"], "pass": [], "fail": ["stat_damage:morale:1"] },
      "play": { "action": ["move_to:graveyard", "resolve_challenge"] }
    },
    {
      "key": "merchant",
      "text": "Wandering Merchant",
      "asset": "gold_coins.jpg",
      "tooltip": "A merchant arrives. Have 2 gold and earn 2 more.",
      "tags": ["challenge"],
      "challenge": { "needs": ["gold >= 2"], "pass": ["stat_gain:gold:2"], "fail": [] },
      "play": { "action": ["move_to:graveyard", "resolve_challenge"] }
    },
    {
      "key": "siege",
      "text": "Siege",
      "asset": "siege_cannon.jpg",
      "tooltip": "Enemy forces lay siege. Need 5 defense or a building takes 2 damage.",
      "tags": ["challenge"],
      "challenge": {
        "needs": ["sum:defense@standing >= 5"],
        "pass": [],
        "fail": ["stat_damage:hp@random.building:2"]
      },
      "play": { "action": ["move_to:graveyard", "resolve_challenge"] }
    },
    {
      "key": "triumph",
      "outcome": "victory",
      "text": "Triumph",
      "asset": "banners_procession.jpg",
      "tooltip": "Your people rejoice — the castle stands proud. Click to return to the menu.",
      "play": { "action": ["load_game:menu.json"] }
    },
    {
      "key": "the_fall",
      "outcome": "defeat",
      "text": "The Castle Falls",
      "asset": "abbey_ruins.jpg",
      "tooltip": "Morale is broken and the halls stand empty. Click to return to the menu.",
      "play": { "action": ["load_game:menu.json"] }
    }
  ],
  "zones": [
    {
      "key": "board",
      "type": "grid",
      "pos": [0.0, 0.0, 0.75, 0.7],
      "grid": [5, 5],
      "tags": ["activate", "tiled"]
    },
    { "key": "hand", "type": "hand", "pos": [0.19, 0.72, 0.75, 0.99] },
    {
      "key": "build_deck",
      "label": "Build Deck",
      "type": "deck",
      "pos": [0.77, 0.19, 0.99, 0.37],
      "tags": ["shuffle", "refill_when_empty"],
      "contents": [
        "watchtower:3",
        "farm:3",
        "market:2",
        "repair:2",
        "mercenaries:2",
        "architect:2",
        "royal_decree:1"
      ]
    },
    {
      "key": "challenge_deck",
      "label": "Challenge Deck",
      "type": "deck",
      "pos": [0.77, 0.39, 0.99, 0.57],
      "tags": ["shuffle", "refill_when_empty"],
      "contents": ["bandit_raid:3", "drought:3", "merchant:2", "siege:2"]
    },
    { "key": "graveyard", "label": "Discard", "type": "pile", "pos": [0.77, 0.59, 0.99, 0.99] },
    {
      "key": "offer",
      "type": "hand",
      "pos": [0.15, 0.32, 0.85, 0.7],
      "tags": ["hidden"],
      "applies": ["draft_pick"]
    },
    {
      "key": "edicts",
      "type": "deck",
      "pos": [0.42, -0.4, 0.58, -0.08],
      "tags": ["hidden"],
      "contents": ["festival", "conscription", "tax_levy"]
    },
    {
      "key": "fate_victory",
      "type": "deck",
      "pos": [0.42, -0.4, 0.58, -0.08],
      "tags": ["hidden"],
      "contents": ["triumph"]
    },
    {
      "key": "fate_defeat",
      "type": "deck",
      "pos": [0.42, -0.4, 0.58, -0.08],
      "tags": ["hidden"],
      "contents": ["the_fall"]
    },
    {
      "key": "decree_offer",
      "type": "hand",
      "pos": [0.15, 0.32, 0.85, 0.7],
      "tags": ["hidden"],
      "applies": ["decree_pick"]
    },
    {
      "key": "victory_offer",
      "type": "hand",
      "pos": [0.15, 0.32, 0.85, 0.7],
      "tags": ["hidden"]
    },
    {
      "key": "defeat_offer",
      "type": "hand",
      "pos": [0.15, 0.32, 0.85, 0.7],
      "tags": ["hidden"]
    }
  ],
  "phases": [
    {
      "key": "build1",
      "type": "draw_and_play",
      "label": "Build I",
      "deck": "build_deck",
      "draw": 3,
      "pass_card": "pass"
    },
    {
      "key": "build2",
      "type": "draw_and_play",
      "label": "Build II",
      "deck": "build_deck",
      "draw": 3,
      "pass_card": "pass"
    },
    {
      "key": "challenge",
      "type": "draw_and_play",
      "label": "Challenge",
      "deck": "challenge_deck",
      "draw": 3,
      "pass_card": "pass"
    },
    {
      "key": "draft",
      "type": "overlay",
      "label": "Choose a building",
      "deck": "build_deck",
      "zone": "offer",
      "draw": 3
    },
    {
      "key": "decree",
      "type": "overlay",
      "label": "Choose an edict",
      "deck": "edicts",
      "zone": "decree_offer",
      "draw": 3
    },
    {
      "key": "victory",
      "type": "overlay",
      "label": "Victory",
      "deck": "fate_victory",
      "zone": "victory_offer",
      "draw": 1
    },
    {
      "key": "defeat",
      "type": "overlay",
      "label": "Defeat",
      "deck": "fate_defeat",
      "zone": "defeat_offer",
      "draw": 1
    }
  ],
  "end_conditions": [
    { "when": "morale == 0", "then": ["push_phase:defeat"] },
    { "when": "morale >= 10", "then": ["push_phase:victory"] }
  ],
  "tags": {
    "draft_pick": {
      "play": { "action": ["add_to:hand", "return_to:offer:build_deck", "shuffle:build_deck"] }
    },
    "decree_pick": { "play": { "action": ["add_to:hand", "return_to:decree_offer:edicts"] } }
  }
}
