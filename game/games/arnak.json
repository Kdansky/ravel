                 "y_arrow", "y_jewel", "y_travel", "y_draw", "y_idol"] },
    "dread": { "color": [0.32, 0.13, 0.14], "badge_run": "down", "badges": ["trek"], "badge_zeros": false },
    "field": { "color": [0.20, 0.38, 0.27], "badge_zeros": false,
      "badges": ["toll", "guard", "y_coin", "y_compass", "y_tablet", "y_arrow", "y_jewel"] },
    "veiled": { "color": [0.16, 0.18, 0.22], "badges": ["toll"], "badge_zeros": false },
    "gilt": { "color": [0.58, 0.47, 0.14], "fit": "fill" },
    "hire": { "color": [0.18, 0.40, 0.44], "badge_run": "down", "badge_zeros": false,
