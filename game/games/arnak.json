  "tags": {
    "deck_card": {
      "abilities": [
        { "key": "travel", "text": "Spend it travelling", "phases": ["turn"],
          "action": ["stat_gain:travel@mine.player:sum:trek@self", "move_to:mine.table"] }
      ]
    },
    "basic": {
      "abilities": [
        { "key": "effect", "text": "Take what it gives (free)", "phases": ["turn"],
          "action": ["stat_gain:coin@mine.player:sum:y_coin@self",
                     "stat_gain:compass@mine.player:sum:y_compass@self",
                     "move_to:mine.table"] }
      ]
    },
    "item": {
      "abilities": [
        { "key": "effect", "text": "Use it — your main action", "phases": ["turn"],
          "cost": { "main@mine.player": 1 },
          "action": ["stat_gain:coin@mine.player:sum:y_coin@self",
                     "stat_gain:compass@mine.player:sum:y_compass@self",
                     "stat_gain:tablet@mine.player:sum:y_tablet@self",
                     "stat_gain:arrowhead@mine.player:sum:y_arrow@self",
                     "stat_gain:jewel@mine.player:sum:y_jewel@self",
                     "stat_gain:travel@mine.player:sum:y_travel@self",
                     "draw_from:mine.bag:mine.hand:sum:y_draw@self",
                     "fill:mine.idols:idol:sum:y_idol@self",
                     "move_to:mine.table"] }
      ]
    },
    "artifact": {
      "abilities": [
        { "key": "effect", "text": "Read it — your main action, and a tablet", "phases": ["turn"],
          "cost": { "main@mine.player": 1, "tablet@mine.player": 1 },
          "action": ["stat_gain:coin@mine.player:sum:y_coin@self",
                     "stat_gain:compass@mine.player:sum:y_compass@self",
                     "stat_gain:tablet@mine.player:sum:y_tablet@self",
                     "stat_gain:arrowhead@mine.player:sum:y_arrow@self",
                     "stat_gain:jewel@mine.player:sum:y_jewel@self",
                     "stat_gain:travel@mine.player:sum:y_travel@self",
                     "draw_from:mine.bag:mine.hand:sum:y_draw@self",
                     "fill:mine.idols:idol:sum:y_idol@self",
                     "move_to:mine.table"] }
      ]
    },
    "site": {
      "abilities": [
        { "key": "dig", "text": "Dig here", "phases": ["turn"], "when": ["guard@self == 0"],
          "cost": { "exhaust": 1, "main@mine.player": 1, "workers@mine.player": 1,
                    "travel@mine.player": "toll@self" },
          "action": ["stat_gain:coin@mine.player:sum:y_coin@self",
                     "stat_gain:compass@mine.player:sum:y_compass@self",
                     "stat_gain:tablet@mine.player:sum:y_tablet@self",
                     "stat_gain:arrowhead@mine.player:sum:y_arrow@self",
                     "stat_gain:jewel@mine.player:sum:y_jewel@self"] },
        { "key": "dig_guarded", "text": "Dig here, under the guardian's eye", "phases": ["turn"],
          "when": ["guard@self >= 1"],
          "cost": { "exhaust": 1, "main@mine.player": 1, "workers@mine.player": 1,
                    "travel@mine.player": "toll@self" },
          "action": ["stat_gain:coin@mine.player:sum:y_coin@self",
                     "stat_gain:compass@mine.player:sum:y_compass@self",
                     "stat_gain:tablet@mine.player:sum:y_tablet@self",
                     "stat_gain:arrowhead@mine.player:sum:y_arrow@self",
                     "stat_gain:jewel@mine.player:sum:y_jewel@self",
                     "stat_gain:guarded@mine.player:1"] },
        { "key": "overcome", "text": "Overcome the guardian", "phases": ["turn"],
          "when": ["guard@self >= 1", "guarded@mine.player >= 1"],
          "cost": { "main@mine.player": 1, "arrowhead@mine.player": "g_arrow@self",
                    "tablet@mine.player": "g_tablet@self", "jewel@mine.player": "g_jewel@self" },
          "action": ["stat_set:guard@self:0", "stat_gain:guardians@mine.player:1",
                     "stat_damage:guarded@mine.player:1"] }
      ]
    },
    "assistant": {
      "tooltip": "Once a round, free. Every assistant is refreshed when the round wraps.",
      "abilities": [
        { "key": "use", "text": "Set them to work", "phases": ["turn"], "cost": { "exhaust": 1 },
          "action": ["stat_gain:coin@mine.player:sum:y_coin@self",
                     "stat_gain:compass@mine.player:sum:y_compass@self",
                     "stat_gain:tablet@mine.player:sum:y_tablet@self",
                     "stat_gain:arrowhead@mine.player:sum:y_arrow@self",
                     "stat_gain:jewel@mine.player:sum:y_jewel@self",
                     "stat_gain:travel@mine.player:sum:y_travel@self",
                     "draw_from:mine.bag:mine.hand:sum:y_draw@self"] }
      ]
    },
    "for_sale_item": {
      "abilities": [
        { "key": "buy_item", "text": "Buy it", "merge": "this", "phases": ["turn"],
          "cost": { "main@mine.player": 1, "coin@mine.player": "price@self" },
          "action": ["move:self:mine.bag:bottom", "draw_from:item_deck:items:1"] }
      ]
    },
    "for_sale_art": {
      "abilities": [
        { "key": "buy_art", "text": "Buy it", "merge": "this", "phases": ["turn"],
          "cost": { "main@mine.player": 1, "compass@mine.player": "price@self" },
          "action": ["move:self:mine.bag:bottom", "draw_from:artifact_deck:artifacts:1"] }
      ]
    }
  },

  "players": [{ "card": "south" }, { "card": "north" }],

  "zones": [
    { "key": "whose_turn", "label": "current_player", "layout": "grid", "grid": [1, 1],
      "pos": [0.005, 0.195, 0.150, 0.240] },
    { "key": "what_now", "label": "current_phase", "layout": "grid", "grid": [1, 1],
      "pos": [0.005, 0.245, 0.150, 0.290] },
    { "key": "controls", "layout": "grid", "grid": [2, 1], "use": "abilities", "tags": ["button"],
      "pos": [0.005, 0.296, 0.150, 0.360] },
    { "key": "research", "label": "Research", "layout": "grid", "grid": [1, 6], "use": "abilities",
      "tags": ["tile"], "pos": [0.005, 0.368, 0.150, 0.805],
      "tooltip": "Two tokens climb this track, cheapest row at the bottom. The notebook may never sit above the magnifying glass, and only the glass reaches the Lost Temple." },

    { "key": "artifacts", "label": "Artifacts", "layout": "grid", "grid": [5, 1], "use": "abilities",
      "applies": ["for_sale_art"], "tags": ["tile"], "pos": [0.160, 0.195, 0.855, 0.345],
      "tooltip": "The artifact half of the card row, bought with compasses. The moon staff gives it one more slot every round. An artifact read out of hand later costs a tablet on top of the action." },
    { "key": "items", "label": "Items", "layout": "grid", "grid": [5, 1], "use": "abilities",
      "applies": ["for_sale_item"], "tags": ["tile"], "pos": [0.160, 0.350, 0.855, 0.500],
      "tooltip": "The item half of the card row, bought with coins. The moon staff takes one slot away every round. Whatever you buy goes to the bottom of your deck." },
    { "key": "island", "label": "The island", "layout": "grid", "grid": [5, 3], "use": "abilities",
      "tags": ["tile"], "pos": [0.160, 0.508, 0.995, 0.805],
      "tooltip": "Known sites along the bottom, unexplored Level I positions above them, Level II above those. Send an archaeologist to one: pay the travel printed on it and take what it yields. One figure a site, whoever gets there first, until the round wraps." },

    { "key": "options", "layout": "row", "status": "offer", "pos": [0.150, 0.250, 0.850, 0.750] },

    { "key": "item_deck", "layout": "stack", "visibility": "secret", "display": "offscreen", "tags": ["shuffle"],
      "contents": ["it_canteen:3", "it_compass:3", "it_shovel:3", "it_rope:3", "it_pickaxe:3",
                   "it_map:3", "it_lantern:3", "it_camera:3", "it_journal:3", "it_tent:3"] },
    { "key": "artifact_deck", "layout": "stack", "visibility": "secret", "display": "offscreen", "tags": ["shuffle"],
      "contents": ["ar_tablet:3", "ar_disc:3", "ar_amulet:3", "ar_mask:3", "ar_scepter:3", "ar_totem:3"] },
    { "key": "site_1_deck", "layout": "stack", "visibility": "secret", "display": "offscreen", "tags": ["shuffle"],
      "contents": ["s1_lagoon", "s1_temple", "s1_quarry", "s1_grotto", "s1_terrace", "s1_spring"] },
    { "key": "site_2_deck", "layout": "stack", "visibility": "secret", "display": "offscreen", "tags": ["shuffle"],
      "contents": ["s2_vault", "s2_obelisk", "s2_gate", "s2_pyramid", "s2_observatory"] },
    { "key": "assistant_box", "layout": "stack", "visibility": "secret", "display": "offscreen", "tags": ["shuffle"],
      "contents": ["asst_scout", "asst_digger", "asst_scribe", "asst_trader"] },

    { "key": "sys", "layout": "grid", "grid": [1, 1], "display": "offscreen" },
    { "key": "rules_win", "layout": "stack", "visibility": "secret", "display": "offscreen" },
    { "key": "rules_temple", "layout": "stack", "visibility": "secret", "display": "offscreen" },
    { "key": "rules_market", "layout": "stack", "visibility": "secret", "display": "offscreen" },

    { "key": "bag", "label": "Deck", "layout": "stack", "visibility": "secret", "copies": "per_seat",
      "pos": [[0.190, 0.815, 0.240, 0.995], [0.005, 0.005, 0.055, 0.185]],
      "tooltip": "Your expedition deck. It is never reshuffled during a round — only when the round ends." },
    { "key": "hand", "label": "Hand", "layout": "row", "visibility": "owner", "use": "abilities",
      "copies": "per_seat", "tags": ["tile"],
      "pos": [[0.245, 0.815, 0.615, 0.995], [0.060, 0.005, 0.430, 0.185]],
      "tooltip": "Play a card for what it says, or spend it for the distance printed on it. Never both, and either way it lands in your play area." },
    { "key": "table", "label": "Played", "layout": "row", "copies": "per_seat",
      "pos": [[0.620, 0.815, 0.795, 0.995], [0.435, 0.005, 0.620, 0.185]],
      "tooltip": "Everything you played this round. When the round ends it is shuffled and put under your deck." },
    { "key": "idols", "label": "Idols", "layout": "grid", "grid": [2, 2], "use": "abilities",
      "copies": "per_seat", "tags": ["tile"],
      "pos": [[0.800, 0.815, 0.895, 0.995], [0.625, 0.005, 0.740, 0.185]],
      "tooltip": "Three points each at the end, kept or slotted." },
    { "key": "assistants", "label": "Assistants", "layout": "grid", "grid": [2, 1], "use": "abilities",
      "copies": "per_seat", "tags": ["tile"],
      "pos": [[0.900, 0.815, 0.995, 0.995], [0.745, 0.005, 0.855, 0.185]],
      "tooltip": "Recruited from the research track. Each works once a round." }
  ],

  "phases": [
    { "key": "setup", "type": "automatic",
      "actions": ["each_seat:fill:mine.bag:funding:2",
                  "each_seat:fill:mine.bag:exploration:2",
                  "each_seat:fill:mine.bag:fear:2",
                  "each_seat:shuffle:mine.bag"],
      "next": [{ "then": "round_start" }] },

    { "key": "round_start", "type": "automatic",
      "actions": ["stat_gain:round_no@clock:1",
                  "activate_zone:rules_market",
                  "each_seat:stat_set:workers@mine.player:2",
                  "each_seat:stat_set:passed@mine.player:0",
                  "each_seat:draw_from:mine.bag:mine.hand:5"],
      "next": [{ "when": "round_no@clock >= 6", "then": "scoring" }, { "then": "turn" }] },

    { "key": "turn", "type": "player_input", "seat": "next", "label": "Your turn",
      "actions": ["stat_set:main@mine.player:1", "stat_set:travel@mine.player:0"],
      "next": [{ "when": "passed@each.anyone.player >= 1", "then": "cleanup" },
               { "when": "passed@enemy.player >= 1", "then": "turn", "seat": "same" },
               { "then": "turn", "seat": "next" }] },

    { "key": "cleanup", "type": "automatic",
      "actions": ["each_seat:fill:mine.table:fear:sum:guarded@mine.player",
                  "each_seat:stat_set:guarded@mine.player:0",
                  "each_seat:stat_set:travel@mine.player:0",
                  "each_seat:move:mine.hand:mine.table",
                  "each_seat:shuffle:mine.table",
                  "each_seat:move:mine.table:mine.bag:bottom"],
      "next": [{ "then": "round_start", "ends_round": true }] },

    { "key": "scoring", "type": "automatic", "label": "Counting up",
      "actions": ["each_seat:stat_gain:score@mine.player:3:x:count:idol@mine.idols",
                  "each_seat:stat_gain:score@mine.player:5:x:sum:guardians@mine.player",
                  "each_seat:stat_gain:score@mine.player:2:x:sum:glass@mine.player",
                  "each_seat:stat_gain:score@mine.player:2:x:sum:note@mine.player",
                  "each_seat:stat_gain:score@mine.player:sum:points@mine.everywhere",
                  "each_seat:stat_damage:score@mine.player:count:fear@mine.everywhere",
                  "activate_zone:rules_win",
                  "reveal:game_over"],
      "next": [{ "then": "over" }] },

    { "key": "over", "type": "player_input", "label": "The expedition is over",
      "next": [{ "then": "over" }] }
  ],

  "setup": {
    "place": [
      { "card": "clock", "zone": "sys" },
      { "card": "end_turn", "zone": "controls", "at": "a1" },
      { "card": "pass_turn", "zone": "controls", "at": "b1" },
      { "card": "res_1", "zone": "research", "at": "a1" },
      { "card": "res_2", "zone": "research", "at": "a2" },
      { "card": "res_3", "zone": "research", "at": "a3" },
      { "card": "res_4", "zone": "research", "at": "a4" },
      { "card": "res_5", "zone": "research", "at": "a5" },
      { "card": "res_6", "zone": "research", "at": "a6" },
      { "card": "site_beach", "zone": "island", "at": "a1" },
      { "card": "site_jungle", "zone": "island", "at": "b1" },
      { "card": "site_cliffs", "zone": "island", "at": "c1" },
      { "card": "site_ruins", "zone": "island", "at": "d1" },
      { "card": "site_cave", "zone": "island", "at": "e1" },
      { "card": "pos_1", "zone": "island", "at": ["a2", "b2", "c2", "d2", "e2"] },
      { "card": "pos_2", "zone": "island", "at": ["a3", "b3", "c3", "d3", "e3"] },
      { "card": "market_first", "zone": "rules_market" },
      { "card": "market_staff", "zone": "rules_market" },
      { "card": "win_south", "zone": "rules_win" },
      { "card": "win_north", "zone": "rules_win" },
      { "card": "first_temple", "zone": "rules_temple" }
    ]
  },

  "cards": [
    { "key": "south", "text": "South", "tags": ["south_side"], "card_stats": { "coin": 2 } },
    { "key": "north", "text": "North", "tags": ["north_side"], "card_stats": { "coin": 1, "compass": 1 } },

    { "key": "clock", "text": "The expedition", "tags": ["clock", "immutable"],
      "card_stats": { "round_no": 0, "temple_taken": 0 } },

    { "key": "funding", "text": "Funding", "tags": ["deck_card", "basic", "parchment"], "asset": "circle:gold",
      "tooltip": "Free: take a coin. Or spend it travelling for 1.",
      "card_stats": { "trek": 1, "y_coin": 1 } },
    { "key": "exploration", "text": "Exploration", "tags": ["deck_card", "basic", "parchment"], "asset": "circle:cyan",
      "tooltip": "Free: take a compass. Or spend it travelling for 1.",
      "card_stats": { "trek": 1, "y_compass": 1 } },
    { "key": "fear", "text": "Fear", "tags": ["deck_card", "fear", "dread"], "asset": "cross:maroon",
      "tooltip": "It does nothing. Spend it travelling for 1, and lose a point for it at the end.",
      "card_stats": { "trek": 1 } },

    { "key": "it_canteen", "text": "Canteen", "tags": ["deck_card", "item", "crate"], "asset": "square:tan",
      "tooltip": "Two coins.", "card_stats": { "price": 2, "trek": 1, "y_coin": 2 } },
    { "key": "it_compass", "text": "Spare Compass", "tags": ["deck_card", "item", "crate"], "asset": "square:cyan",
      "tooltip": "Two compasses.", "card_stats": { "price": 2, "trek": 1, "y_compass": 2 } },
    { "key": "it_shovel", "text": "Shovel", "tags": ["deck_card", "item", "crate"], "asset": "square:silver",
      "tooltip": "An arrowhead and a tablet.", "card_stats": { "price": 3, "trek": 1, "y_arrow": 1, "y_tablet": 1 } },
