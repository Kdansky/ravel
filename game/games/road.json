  "cards": [
    {
      "key": "p_depart",
      "text": "The Long Road",
      "story": "The city burned a week ago; whatever it was to you, it is smoke now. What is left of your caravan points itself at the mountains, twelve miles of bad country between you and the winter halls of your kin. Every dawn the road sends something new to meet you. Every dusk you choose: spend the bread, or spend the heart.",
      "play": { "action": [] }
    },
    {
      "key": "march",
      "text": "March",
      "tooltip": "Break camp and cover a mile. Costs 1 supply.",
      "tags": ["token", "moss"],
      "play": {
        "cost": { "supplies": 1 },
        "action": ["stat_gain:distance:1", "destroy_self", "next_phase"]
      }
    },
    {
      "key": "hard_march",
      "text": "Hungry March",
      "tooltip": "March on empty bellies: a mile for 1 morale.",
      "tags": ["token", "rust"],
      "play": { "action": ["stat_damage:morale:1", "stat_gain:distance:1", "destroy_self", "next_phase"] }
    },
    {
      "key": "outrider",
      "text": "Outrider",
      "asset": "horseman_dusk.jpg",
      "tooltip": "Sabres at dusk: strikes a threat for 2, once per day.",
      "tags": ["unit"],
      "card_stats": { "hp": [2, 2] },
      "play": { "action": ["move_to"] },
      "activate": {
        "action": ["effect:sabre_hit", "stat_damage:hp@random.threat:2"],
        "cost": { "exhaust": 1 }
      }
    },
    {
      "key": "pikemen",
      "text": "Pikemen",
      "asset": "pikemen_spears.jpg",
      "tooltip": "A wall that walks: strikes a threat for 1, once per day.",
      "tags": ["unit"],
      "card_stats": { "hp": [4, 4] },
      "play": { "action": ["move_to"] },
      "activate": {
        "action": ["effect:sabre_hit", "stat_damage:hp@random.threat:1"],
        "cost": { "exhaust": 1 }
      }
    },
    {
      "key": "huntsman",
      "text": "Huntsman",
      "asset": "hunter_forest.jpg",
      "tooltip": "Knows what the land hides: +1 supply, once per day.",
      "tags": ["unit"],
      "card_stats": { "hp": [2, 2] },
      "play": { "action": ["move_to"] },
      "activate": { "action": ["stat_gain:supplies:1"], "cost": { "exhaust": 1 } }
    },
    {
      "key": "torch",
      "text": "Pitch Torch",
      "asset": "torch_night.jpg",
      "tooltip": "Some things on the road fear fire. Keep it dry.",
      "tags": ["item"],
      "play": { "action": ["move_to"] }
    },
    {
      "key": "waybread",
      "text": "Waybread",
      "asset": "bread_still.jpg",
      "tooltip": "Use it up: +2 supplies, then it is gone.",
      "tags": ["item"],
      "play": { "action": ["move_to"] },
      "activate": { "action": ["stat_gain:supplies:2", "destroy_self"], "cost": { "exhaust": 1 } }
    },
    {
      "key": "lucky_shoe",
      "text": "Lucky Horseshoe",
      "asset": "blacksmith_forge.jpg",
      "tooltip": "Nobody believes in it. +1 morale every day anyway.",
      "tags": ["item"],
      "play": { "action": ["move_to"] },
      "turn": { "action": ["stat_gain:morale:1"] }
    },
    {
      "key": "second_wind",
      "text": "Second Wind",
      "asset": "tavern_meal.jpg",
      "tooltip": "A hot meal and an old song. +2 morale.",
      "play": {
        "cost": { "supplies": 1 },
        "action": ["effect:hearth_glow", "stat_gain:morale:2", "move_to:graveyard"]
      },
      "tags": ["moss"]
    },
    {
      "key": "forced_march",
      "text": "Forced March",
      "asset": "marching_column.jpg",
      "tooltip": "Two miles before moonrise, and everyone hates you. Costs 1 morale.",
      "play": { "cost": { "morale": 1 }, "action": ["stat_gain:distance:2", "move_to:graveyard"] },
      "tags": ["rust"]
    },
    {
      "key": "scavenge",
      "text": "Scavenge the Field",
      "asset": "battle_aftermath.jpg",
      "tooltip": "Strip a slain threat: clear it from the road, +2 supplies.",
      "play": {
        "target": { "type": "card", "min": 1, "max": 1, "tags": ["slain"], "zones": ["battlefield"] },
        "action": ["move_target_to:graveyard", "stat_gain:supplies:2", "move_to:graveyard"]
      },
      "tags": ["slate"]
    },
    {
      "key": "campfire_songs",
      "text": "Campfire Songs",
      "asset": "campfire_night.jpg",
      "tooltip": "The old verses: +1 morale for every unit still standing.",
      "play": { "action": ["stat_gain:morale:count:unit", "move_to:graveyard"] },
      "tags": ["moss"]
    },
    {
      "key": "burn_the_wagons",
      "text": "Burn the Wagons",
      "asset": "wagon_fire.jpg",
      "tooltip": "Lighter, faster, colder. Sacrifice a unit to cover 3 miles at a stroke.",
      "play": {
        "cost": { "sacrifice:unit": 1 },
        "action": [
          "effect:wagon_blaze",
          "stat_gain:distance:3",
          "stat_gain:morale:1",
          "move_to:graveyard"
        ]
      }
    },
    {
      "key": "wolves",
      "text": "Wolf Pack",
      "asset": "wolves_winter.jpg",
      "tooltip": "They pace the column after dark. -1 morale each day it lives.",
      "tags": ["threat"],
      "card_stats": { "hp": [2, 2] },
      "turn": { "action": ["effect:wolf_bite", "stat_damage:morale:1"] }
    },
    {
      "key": "mire",
      "text": "The Mire",
      "asset": "swamp_mire.jpg",
      "tooltip": "The road drowns and the wagons sink. -1 supply each day it lasts.",
      "tags": ["threat"],
      "card_stats": { "hp": [2, 2] },
      "turn": { "action": ["stat_damage:supplies:1"] }
    },
    {
      "key": "night_things",
      "text": "Night-Things",
      "asset": "dark_forest.jpg",
      "tooltip": "Never quite seen, never quite gone. -1 morale each day.",
      "tags": ["threat"],
      "card_stats": { "hp": [3, 3] },
      "turn": { "action": ["stat_damage:morale:1"] }
    },
    {
      "key": "ash_knights",
      "text": "Ash Knights",
      "asset": "dark_riders.jpg",
      "tooltip": "Riders in burnt colors. -1 morale and -1 supply each day they shadow you.",
      "tags": ["threat"],
      "card_stats": { "hp": [4, 4] },
      "turn": { "action": ["stat_damage:morale:1", "stat_damage:supplies:1"] }
    },
    {
      "key": "dark_ford",
      "text": "The Dark Ford",
      "asset": "river_ford.jpg",
      "tooltip": "The water wants a light. Answer it with a torch in the wagons, or cut a way through.",
      "tags": ["threat"],
      "card_stats": { "hp": [3, 3] },
      "challenge": {
        "needs": { "card:torch": 1 },
        "pass": ["move_to:graveyard", "stat_gain:distance:1", "stat_gain:morale:1"],
        "fail": ["stat_damage:morale:2"]
      },
      "activate": { "action": ["resolve_challenge"], "cost": { "exhaust": 1 } },
      "turn": { "action": ["stat_damage:morale:1"] }
    },
    {
      "key": "toll_bridge",
      "text": "The Toll Bridge",
      "asset": "stone_bridge.jpg",
      "tooltip": "The keeper counts your sacks. Answer with 3 supplies in hand (2 are taken), or cut a way through.",
      "tags": ["threat"],
      "card_stats": { "hp": [3, 3] },
      "challenge": {
        "needs": { "supplies": 3 },
        "pass": ["move_to:graveyard", "stat_damage:supplies:2", "stat_gain:distance:2"],
        "fail": ["stat_damage:morale:1"]
      },
      "activate": { "action": ["resolve_challenge"], "cost": { "exhaust": 1 } },
      "turn": { "action": ["stat_damage:morale:1"] }
    },
    {
      "key": "e_home",
      "text": "The Winter Halls",
      "outcome": "victory",
      "story": "The pass opens and there they are: lamplit windows cut into the mountain's shoulder, woodsmoke standing straight up into the cold. Someone on the wall starts ringing the little bell they ring for kin. Whatever you spent on the road — bread, blood, the wagons themselves — the column walks in singing.",
      "play": { "action": ["load_game:menu.json"] }
    },
    {
      "key": "e_broken",
      "text": "The Column Breaks",
      "outcome": "defeat",
      "story": "It isn't one thing. It's the wolves and the rain and the third night without bread, and then one morning the road is full of people quietly walking in different directions. You shout until your voice goes. The mountains keep their winter to themselves.",
      "play": { "action": ["load_game:menu.json"] }
    },
    {
      "key": "e_winter",
      "text": "Snowed In",
      "story": "The first real snow comes down like a door closing. You dig in where the road stands, burn what you can spare and some of what you can't, and learn the long arithmetic of waiting. In spring, the survivors finish the last miles in silence. The halls take you in; the road keeps its share.",
      "play": { "action": ["load_game:menu.json"] }
    }
  ],
  "phases": [
    { "key": "depart", "type": "automatic", "actions": ["reveal:p_depart"] },
    {
      "key": "dawn_near",
      "type": "automatic",
      "actions": ["draw_from:road_near:battlefield:1"],
      "next": [{ "then": "camp" }]
    },
    {
      "key": "dawn_far",
      "type": "automatic",
      "actions": ["draw_from:road_far:battlefield:1"],
      "next": [{ "then": "camp" }]
    },
    {
      "key": "camp",
      "type": "player_input",
      "label": "Making Camp",
      "deck": "camp_deck",
      "draw": 3,
      "pass_card": ["march", "hard_march"],
      "next": [
        { "stat": "distance", "at_least": 6, "then": "dawn_far", "ends_round": true },
        { "then": "dawn_near", "ends_round": true }
      ],
      "tags": ["discard_hand"]
    }
  ],
  "end_conditions": [
    { "stat": "morale", "at_most": 0, "then": ["reveal:e_broken"] },
    { "stat": "distance", "at_least": 12, "then": ["reveal:e_home"] },
    { "stat": "round", "at_least": 16, "then": ["reveal:e_winter"] }
  ]
}
