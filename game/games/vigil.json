      "pos": [0.19, 0.47, 0.85, 0.95],
      "grid": [4, 2],
      "contents": ["tome:2"],
      "tags": ["activate"]
    },
    { "key": "discard", "label": "Spent", "type": "pile", "pos": [0.875, 0.52, 0.99, 0.9] },
    {
      "key": "fate",
      "type": "deck",
      "tags": ["shuffle", "refill_when_empty", "hidden"],
      "contents": ["a_page:3", "a_whisper:2", "a_patron:2", "a_nightmare:2", "a_revelation:1", "an_omen:2"]
    },
    { "key": "offer", "type": "hand", "pos": [0.15, 0.32, 0.85, 0.7], "tags": ["hidden"] },
    { "key": "fate_win", "type": "deck", "tags": ["hidden"], "contents": ["ascended"] },
    { "key": "fate_dead", "type": "deck", "tags": ["hidden"], "contents": ["perished"] },
    { "key": "fate_mad", "type": "deck", "tags": ["hidden"], "contents": ["unmade"] },
    { "key": "fate_late", "type": "deck", "tags": ["hidden"], "contents": ["too_late"] }
  ],
  "phases": [
    { "key": "day", "type": "player_input", "label": "Day" },
    {
      "key": "night",
      "type": "automatic",
      "label": "Night",
      "actions": ["stat_set:time:3", "stat_damage:health:1"]
    },
    {
      "key": "ascension",
      "type": "overlay",
      "label": "Ascension",
      "deck": "fate_win",
      "zone": "offer",
      "draw": 1
    },
    {
      "key": "death",
      "type": "overlay",
      "label": "Death",
      "deck": "fate_dead",
      "zone": "offer",
      "draw": 1
    },
    {
      "key": "madness",
      "type": "overlay",
      "label": "Madness",
      "deck": "fate_mad",
      "zone": "offer",
      "draw": 1
    },
    {
      "key": "too_slow",
      "type": "overlay",
      "label": "The Hour Passes",
      "deck": "fate_late",
      "zone": "offer",
      "draw": 1
    }
  ],
  "end_conditions": [
    { "when": "ritual >= 3", "then": ["push_phase:ascension"] },
    { "when": "health <= 0", "then": ["push_phase:death"] },
    { "when": "dread >= 10", "then": ["push_phase:madness"] },
    { "when": "round >= 15", "then": ["push_phase:too_slow"] }
  ]
}
