{
  "title": "The Long Vigil",
  "stats": [
    { "key": "round", "label": "Day" },
    { "key": "time", "label": "Time", "min": 0, "max": 9 },
    { "key": "health", "label": "Health", "min": 0, "max": 10 },
    { "key": "funds", "label": "Funds", "min": 0, "max": 99 },
    { "key": "insight", "label": "Insight", "min": 0, "max": 99 },
    { "key": "dread", "label": "Dread", "min": 0, "max": 10 },
    { "key": "ritual", "label": "Rite", "min": 0, "max": 3 }
  ],
  "tags": {
    "lore": { "zone": "holdings" },
    "follower": { "zone": "holdings" },
    "verb": { "zone": "table" }
  },
  "setup": {
    "place": [
      { "card": "pass_night", "zone": "table", "at": "a1" },
      { "card": "work", "zone": "table", "at": "b1" },
      { "card": "rest", "zone": "table", "at": "c1" },
      { "card": "carouse", "zone": "table", "at": "h1" },
      { "card": "study", "zone": "table", "at": "d1" },
      { "card": "commune", "zone": "table", "at": "e1" },
      { "card": "dream", "zone": "table", "at": "f1" },
      { "card": "the_rite", "zone": "table", "at": "g1" }
    ]
  },
  "players": [{ "stats": { "time": 3, "health": 10, "funds": 4, "insight": 0, "dread": 0, "ritual": 0 } }],
  "cards": [
    {
      "key": "pass_night",
      "text": "Nightfall",
      "asset": "moonlit_night.jpg",
      "tooltip": "End the day. Your strength fades by one, your followers tithe, and the hours return to you.",
      "tags": ["verb"],
      "activate": { "action": ["next_phase"] }
    },
    {
      "key": "work",
      "text": "Work",
      "asset": "blacksmith_forge.jpg",
      "tooltip": "An honest day at the forge. Costs 1 time, earns 2 funds. Once per day.",
      "tags": ["verb"],
      "activate": { "cost": { "exhaust": 1, "time": 1 }, "action": ["stat_gain:funds:2"] }
    },
    {
      "key": "rest",
      "text": "Rest",
      "asset": "campfire_night.jpg",
      "tooltip": "Sleep, and do not dream. Costs 1 time, restores 3 health. It does nothing for what you already know. Once per day.",
      "tags": ["verb"],
      "activate": { "cost": { "exhaust": 1, "time": 1 }, "action": ["stat_gain:health:3"] }
    },
    {
      "key": "carouse",
      "text": "Carouse",
      "asset": "brawl_men.jpg",
      "tooltip": "Drink with people who have never read anything. Costs 1 time and 2 funds, settles 3 dread. Once per day.",
      "tags": ["verb"],
      "activate": { "cost": { "exhaust": 1, "time": 1, "funds": 2 }, "action": ["stat_damage:dread:3"] }
    },
    {
      "key": "study",
      "text": "Study",
      "asset": "alchemist_study.jpg",
      "tooltip": "Read a tome to the end and burn what is left. Costs 1 time and one tome, yields 2 insight. Once per day.",
      "tags": ["verb"],
      "activate": {
        "cost": { "exhaust": 1, "time": 1 },
        "target": { "type": "card", "count": 1, "tags": ["lore"], "zones": ["holdings"] },
        "action": ["stat_gain:insight:2", "move_target_to:discard"]
      }
    },
    {
      "key": "commune",
      "text": "Commune",
      "asset": "tavern_meal.jpg",
      "tooltip": "Buy a stranger a meal and speak of the work. Costs 1 time and 3 funds, gains a follower. Once per day.",
      "tags": ["verb"],
      "activate": { "cost": { "exhaust": 1, "time": 1, "funds": 3 }, "action": ["gain:follower:1"] }
    },
    {
      "key": "dream",
      "text": "Dream",
      "asset": "dark_forest.jpg",
      "tooltip": "Pay the dream-seller and go down the stair. Costs 1 time, 1 fund and 1 dread — the stair always takes that. What you find below is not yours to choose. Once per day.",
      "tags": ["verb"],
      "activate": {
        "cost": { "exhaust": 1, "time": 1, "funds": 1 },
        "action": ["stat_gain:dread:1", "reveal_top:fate"]
      }
    },
    {
      "key": "the_rite",
      "text": "The Rite",
      "asset": "chapel_altar.jpg",
      "tooltip": "Perform one third of the work. Costs 2 time, 5 insight, and one follower, who does not come back. Three rites and the vigil ends.",
      "tags": ["verb"],
      "activate": {
        "cost": { "exhaust": 1, "time": 2, "insight": 5, "sacrifice:follower": 1 },
        "action": ["stat_gain:ritual:1"]
      }
    },
    {
      "key": "tome",
      "text": "Tome",
      "asset": "candle_night.jpg",
      "tooltip": "Somebody wrote this down so they would not have to remember it. Study consumes it.",
      "tags": ["lore"]
    },
    {
      "key": "follower",
      "text": "Follower",
      "asset": "merchant_portrait.jpg",
      "tooltip": "They tithe 1 fund each night. They believe the vigil ends well for everyone.",
      "tags": ["follower"],
      "turn": { "action": ["stat_gain:funds:1"] }
    },
    {
      "key": "a_page",
      "text": "A Loose Page",
      "asset": "old_bell.jpg",
      "tooltip": "Torn from something larger, and legible. It becomes a tome.",
      "play": { "action": ["gain:tome:1"] }
    },
    {
      "key": "a_whisper",
      "text": "A Whisper",
      "asset": "torch_night.jpg",
      "tooltip": "One word, in a voice you know. +1 insight, +1 dread.",
      "play": { "action": ["stat_gain:insight:1", "stat_gain:dread:1"] }
    },
    {
      "key": "a_patron",
      "text": "A Patron",
      "asset": "gold_coins.jpg",
      "tooltip": "Someone wealthy is interested in your work. +4 funds.",
      "play": { "action": ["stat_gain:funds:4"] }
    },
    {
      "key": "a_nightmare",
      "text": "A Nightmare",
      "asset": "wolves_winter.jpg",
      "tooltip": "You are followed through the snow and you do not wake until it catches you. -2 health, +2 dread.",
      "play": { "action": ["stat_damage:health:2", "stat_gain:dread:2"] }
    },
    {
      "key": "a_revelation",
      "text": "A Revelation",
      "asset": "eclipse_sun.jpg",
      "tooltip": "For a moment the whole shape of it is plain. +3 insight.",
      "play": { "action": ["stat_gain:insight:3"] }
    },
    {
      "key": "an_omen",
      "text": "An Omen",
      "asset": "blighted_tree.jpg",
      "tooltip": "The tree by the gate is dead on one side only. +2 dread, and a tome you did not buy.",
      "play": { "action": ["stat_gain:dread:2", "gain:tome:1"] }
    },
    {
      "key": "ascended",
      "outcome": "victory",
      "text": "The Vigil Ends",
      "asset": "starry_tower.jpg",
      "tooltip": "Three rites, and the door opens from the other side. Click to return to the menu.",
      "play": { "action": ["load_game:menu.json"] }
    },
    {
      "key": "perished",
      "outcome": "defeat",
      "text": "You Do Not Wake",
      "asset": "graveyard_mist.jpg",
      "tooltip": "The body gives out before the work is done. Click to return to the menu.",
      "play": { "action": ["load_game:menu.json"] }
    },
    {
      "key": "unmade",
      "outcome": "defeat",
      "text": "Nothing Left to Frighten",
      "asset": "swamp_mire.jpg",
      "tooltip": "The dread finishes what the dreams began. Click to return to the menu.",
      "play": { "action": ["load_game:menu.json"] }
    },
    {
      "key": "too_late",
      "outcome": "defeat",
      "text": "The Hour Passes",
      "asset": "old_door.jpg",
      "tooltip": "The conjunction holds for fourteen nights and not one more. You were close. Click to return to the menu.",
      "play": { "action": ["load_game:menu.json"] }
    }
  ],
  "zones": [
    {
      "key": "table",
      "label": "The Work",
      "type": "grid",
      "pos": [0.02, 0.05, 0.86, 0.42],
      "grid": [8, 1],
      "tags": ["activate"]
    },
    {
      "key": "holdings",
      "label": "Holdings",
