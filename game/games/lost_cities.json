    {
      "key": "setup",
      "type": "automatic",
      "actions": [
        "draw_from:deck:mine.hand:8",
        "draw_from:deck:enemy.hand:8",
        "fill:mode:mode_local:1",
        "fill:mode:mode_online:1",
        "push_phase:mode"
      ]
    },
    {
      "key": "play",
      "type": "player_input",
      "zone": "hand",
      "label": "Play or discard",
      "seat": "next",
      "ends_after": 1,
      "next": [{ "then": "draw" }]
    },
    {
      "key": "draw",
      "type": "player_input",
      "zone": "choice",
      "label": "Draw from the deck, or take the top of a discard",
      "tags": ["discard_hand"],
      "next": [{ "zone_empty": ["deck"], "then": "tally" }, { "then": "play" }]
    },
    {
      "key": "tally",
      "type": "player_input",
      "label": "Tally",
      "seat": "next",
      "zone": "choice",
      "tags": ["discard_hand"],
      "pass_card": [
        "red_score",
        "green_score",
        "blue_score",
        "white_score",
        "yellow_score",
        "red_bonus",
        "green_bonus",
        "blue_bonus",
        "white_bonus",
        "yellow_bonus",
        "done_scoring"
      ],
      "next": [{ "when": "tallied@player >= 2", "then": "ending" }, { "then": "tally" }]
    },
    {
      "key": "ending",
      "type": "automatic",
      "actions": [],
      "next": [
        { "when": "score@north_side >= score@south_side", "then": "north_end" },
        { "then": "south_end" }
      ]
    },
    {
      "key": "north_end",
      "type": "automatic",
      "actions": ["stat_gain:won@north_side:1", "reveal:north_wins"]
    },
    {
      "key": "south_end",
      "type": "automatic",
      "actions": ["stat_gain:won@south_side:1", "reveal:south_wins"]
    },
    { "key": "mode", "type": "overlay", "zone": "mode" }
  ],
