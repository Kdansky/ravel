{
  "title": "Runeterra — vanilla combat",
  "players": [{ "card": "north" }, { "card": "south" }],
  "stats": [
    { "key": "nexus", "label": "Nexus", "icon": "heart", "min": 0, "max": 99, "subject": "nexus@mine.player" },
    { "key": "mana", "label": "Mana", "icon": "diamond", "min": 0, "max": 10, "subject": "mana@mine.player" },
    { "key": "power", "icon": "blade", "tags": ["hidden"] },
    { "key": "health", "icon": "heart", "tags": ["hidden"] },
    { "key": "incoming", "min": 0, "on": ["unit"], "start": 0, "tags": ["hidden"] }
  ],
  "computed_tags": {
    "dead": { "stat": "health", "less_than": 1 },
    "passed": { "stat": "passed", "at_least": 1 }
  },
  "computes": [
    { "key": "overkill", "from": "0 - health@across",
      "tooltip": "How far past death the unit across this one was struck. Health has no floor, so a blocker carries its own overkill as a negative number." }
  ],
  "styles": {
    "unit": { "fit": "card", "badges": ["power", "health"] },
    "nexus_plate": { "fit": "card", "badges": ["nexus", "mana"], "cell_outline": false },
    "lane": { "chequer": ["#243248", "#2b3a55"], "cell_outline": false }
  },
  "patterns": {
    "across": { "vectors": [[0, 1], [0, -1]], "class": ["step"] }
  },
  "tags": {
    "tough": {
      "tooltip": "Tough — takes 1 less damage from every source.",
      "abilities": [
        {
          "key": "armor",
          "phases": ["strike"],
          "action": ["stat_damage:incoming@self:1"]
        }
      ]
    },
    "overwhelm": {
      "tooltip": "Overwhelm — damage past the blocker hits the Nexus.",
      "abilities": [
        {
          "key": "spill",
          "text": "Overwhelm",
          "phases": ["strike"],
          "compute": ["overkill"],
          "when": ["attacking@self >= 1", "overkill >= 1"],
          "action": ["stat_gain:spill@self:overkill"]
        }
      ]
    },
    "on_bench": {
      "abilities": [
        {
          "key": "attack",
          "text": "Attack",
          "tooltip": "Send this unit into one of your lanes.",
          "phases": ["declare_attack"],
          "target": {
            "type": "slot", "count": 1, "zones": ["battle"], "fill": "empty",
            "where": ["row@target == side@mine.player"]
          },
          "action": ["stat_set:attacking@self:1", "move_to:target"]
        },
        {
          "key": "block",
          "text": "Block",
          "tooltip": "Meet an attacker. A lane with nothing across it cannot be blocked into.",
          "phases": ["declare_block"],
          "target": {
            "type": "slot", "count": 1, "zones": ["battle"], "fill": "empty",
            "where": [
              "row@target == side@mine.player",
              "count:unit@across >= 1"
            ]
          },
          "action": ["move_to:target"]
        }
      ]
    },
    "in_combat": {
      "abilities": [
        {
          "key": "aim",
          "text": "Strike",
          "action": ["stat_gain:incoming@across:sum:power@self"]
        },
        {
          "key": "land",
          "action": ["stat_damage:health@self:sum:incoming@self"]
        },
        {
          "key": "spill",
          "when": ["attacking@self >= 1", "count:unit@across == 0"],
          "action": ["stat_set:spill@self:sum:power@self"]
        }
      ]
    }
  },
  "zones": [
    {
      "key": "nexus_north",
      "type": "grid",
      "grid": [1, 1],
      "tags": ["nexus_plate"],
      "pos": [0.01, 0.18, 0.15, 0.45]
    },
    {
      "key": "nexus_south",
      "type": "grid",
      "grid": [1, 1],
      "tags": ["nexus_plate"],
      "pos": [0.01, 0.55, 0.15, 0.82]
    },
    {
      "key": "deck",
      "label": "Deck",
      "type": "deck",
      "tags": ["per_seat", "shuffle"],
      "pos": [[0.84, 0.10, 0.98, 0.30], [0.84, 0.70, 0.98, 0.90]],
      "contents": [
        "plucky_poro:3", "cithria:3", "vanguard_defender:3", "vanguard_lookout:3",
        "ruthless_raider:3", "loyal_badgerbear:3", "mighty_poro:3", "bull_elnuk:3",
        "vanguard_cavalry:3", "alpha_wildclaw:3"
      ]
    },
    {
      "key": "hand",
      "type": "hand",
      "tags": ["per_seat"],
      "pos": [[0.04, 0.01, 0.80, 0.11], [0.04, 0.89, 0.80, 0.99]]
    },
    {
      "key": "bench",
      "label": "Bench",
      "type": "grid",
      "grid": [6, 1],
      "tags": ["per_seat", "activate"],
      "applies": ["on_bench"],
      "pos": [[0.16, 0.13, 0.80, 0.28], [0.16, 0.72, 0.80, 0.87]]
    },
    {
      "key": "controls",
      "type": "grid",
      "grid": [2, 1],
      "tags": ["per_seat", "activate", "optional"],
      "pos": [[0.82, 0.32, 0.98, 0.48], [0.82, 0.52, 0.98, 0.68]]
    },
    {
      "key": "battle",
      "type": "grid",
      "grid": [6, 2],
      "tags": ["lane"],
      "applies": ["in_combat"],
      "pos": [0.16, 0.31, 0.80, 0.69]
    }
  ],
  "phases": [
    {
      "key": "setup",
      "type": "automatic",
      "actions": [
        "draw_from:mine.deck:mine.hand:4",
        "draw_from:enemy.deck:enemy.hand:4"
      ],
      "next": [{ "then": "round_start" }]
    },
    {
      "key": "round_start",
      "type": "automatic",
      "actions": [
        "draw_from:mine.deck:mine.hand:1",
        "draw_from:enemy.deck:enemy.hand:1",
        "stat_set:mana@each.anyone.player:0",
        "stat_gain:mana@each.anyone.player:max:round",
        "stat_set:token@north_side:sum:attacker@north_side",
        "stat_set:token@south_side:sum:attacker@south_side",
        "stat_set:passed@each.anyone.pass_button:0"
      ],
      "next": [{ "then": "play" }]
    },
    {
      "key": "play",
      "type": "player_input",
      "label": "Play a unit, attack, or pass",
      "seat": "next",
      "zone": "hand",
      "next": [
        { "when": "attack_declared@anyone.player >= 1", "then": "declare_attack" },
        { "when": "count:passed >= 2", "then": "round_end" },
        { "then": "hand_over" }
      ]
    },
    {
      "key": "hand_over",
      "type": "automatic",
      "actions": ["stat_set:passed@each.enemy.pass_button:0"],
      "next": [{ "then": "play" }]
    },
    {
      "key": "declare_attack",
      "type": "player_input",
      "label": "Send units into your lanes, then press Done",
      "zone": "bench",
      "actions": ["stat_set:attacking@each.bench:0"],
      "next": [{ "then": "declare_block" }]
    },
    {
      "key": "declare_block",
      "type": "player_input",
      "label": "Block what you can, then press Done",
      "seat": "next",
      "zone": "bench",
      "next": [{ "then": "strike" }]
    },
    {
      "key": "strike",
      "type": "automatic",
      "actions": [
        "stat_set:spill@each.battle:0",
        "stat_set:incoming@each.battle:0",
        "activate_zone:battle:by_column:aim",
        "activate_zone:battle:by_column:armor",
        "activate_zone:battle:by_column:land",
        "activate_zone:battle:by_column:spill"
      ],
      "next": [
        { "when": "attacker@north_side >= 1", "then": "nexus_south" },
        { "then": "nexus_north" }
      ]
    },
    {
      "key": "nexus_south",
      "type": "automatic",
      "actions": ["stat_damage:nexus@south_side:sum:spill@battle"],
      "next": [{ "then": "after_combat" }]
    },
    {
      "key": "nexus_north",
      "type": "automatic",
      "actions": ["stat_damage:nexus@north_side:sum:spill@battle"],
      "next": [{ "then": "after_combat" }]
    },
    {
      "key": "after_combat",
      "type": "automatic",
      "actions": [
        "destroy:dead",
        "stat_set:attacking@each.battle:0",
        "stat_set:spill@each.battle:0",
        "move:mine.battle:mine.bench",
        "move:enemy.battle:enemy.bench",
        "stat_set:attack_declared@each.anyone.player:0",
        "stat_set:passed@each.anyone.pass_button:0"
      ],
      "next": [{ "then": "play", "seat": "same" }]
    },
    {
      "key": "round_end",
      "type": "automatic",
      "actions": [],
      "next": [
        { "when": "attacker@north_side >= 1", "then": "token_to_south" },
        { "then": "token_to_north" }
      ]
    },
    {
      "key": "token_to_south",
      "type": "automatic",
      "actions": [
        "stat_set:attacker@north_side:0",
        "stat_set:attacker@south_side:1"
      ],
      "next": [{ "then": "round_start", "ends_round": true }]
    },
    {
      "key": "token_to_north",
      "type": "automatic",
      "actions": [
        "stat_set:attacker@north_side:1",
        "stat_set:attacker@south_side:0"
      ],
      "next": [{ "then": "round_start", "ends_round": true }]
    }
  ],
  "end_conditions": [
    { "when": "nexus@north_side <= 0", "then": ["stat_gain:won@south_side:1", "reveal:south_wins"] },
    { "when": "nexus@south_side <= 0", "then": ["stat_gain:won@north_side:1", "reveal:north_wins"] }
  ],
  "cards": [
    {
      "key": "north",
      "text": "North",
      "asset": "polygon:6:crimson",
      "tags": ["north_side", "nexus_plate"],
      "card_stats": { "nexus": 20, "mana": 0, "side": 2, "attacker": 1, "token": 0, "attack_declared": 0 }
    },
    {
      "key": "south",
      "text": "South",
      "asset": "polygon:6:teal",
      "tags": ["south_side", "nexus_plate"],
      "card_stats": { "nexus": 20, "mana": 0, "side": 1, "attacker": 0, "token": 0, "attack_declared": 0 }
    },

    {
      "key": "plucky_poro",
      "text": "Plucky Poro",
      "asset": "circle:1:silver",
      "tags": ["unit", "tough"],
      "card_stats": { "power": 1, "health": 1, "cost": 1, "attacking": 0, "spill": 0 },
      "play": { "cost": { "mana": 1 }, "target": { "type": "slot", "count": 1, "zones": ["bench"], "fill": "empty" }, "action": ["move_to:target", "next_phase"] }
    },
    {
      "key": "cithria",
      "text": "Cithria of Cloudfield",
      "asset": "circle:1:gold",
      "tags": ["unit"],
      "card_stats": { "power": 2, "health": 2, "cost": 1, "attacking": 0, "spill": 0 },
      "play": { "cost": { "mana": 1 }, "target": { "type": "slot", "count": 1, "zones": ["bench"], "fill": "empty" }, "action": ["move_to:target", "next_phase"] }
    },
    {
      "key": "vanguard_defender",
      "text": "Vanguard Defender",
      "asset": "square:2:gold",
      "tags": ["unit", "tough"],
      "card_stats": { "power": 2, "health": 2, "cost": 2, "attacking": 0, "spill": 0 },
      "play": { "cost": { "mana": 2 }, "target": { "type": "slot", "count": 1, "zones": ["bench"], "fill": "empty" }, "action": ["move_to:target", "next_phase"] }
    },
    {
      "key": "vanguard_lookout",
      "text": "Vanguard Lookout",
      "asset": "square:2:silver",
      "tags": ["unit"],
      "card_stats": { "power": 1, "health": 4, "cost": 2, "attacking": 0, "spill": 0 },
      "play": { "cost": { "mana": 2 }, "target": { "type": "slot", "count": 1, "zones": ["bench"], "fill": "empty" }, "action": ["move_to:target", "next_phase"] }
    },
    {
      "key": "ruthless_raider",
      "text": "Ruthless Raider",
      "asset": "triangle:2:crimson",
      "tags": ["unit", "tough", "overwhelm"],
      "card_stats": { "power": 3, "health": 1, "cost": 2, "attacking": 0, "spill": 0 },
      "play": { "cost": { "mana": 2 }, "target": { "type": "slot", "count": 1, "zones": ["bench"], "fill": "empty" }, "action": ["move_to:target", "next_phase"] }
    },
    {
      "key": "loyal_badgerbear",
      "text": "Loyal Badgerbear",
      "asset": "square:3:gold",
      "tags": ["unit"],
      "card_stats": { "power": 3, "health": 4, "cost": 3, "attacking": 0, "spill": 0 },
      "play": { "cost": { "mana": 3 }, "target": { "type": "slot", "count": 1, "zones": ["bench"], "fill": "empty" }, "action": ["move_to:target", "next_phase"] }
    },
    {
      "key": "mighty_poro",
      "text": "Mighty Poro",
      "asset": "triangle:3:silver",
      "tags": ["unit", "overwhelm"],
      "card_stats": { "power": 3, "health": 3, "cost": 3, "attacking": 0, "spill": 0 },
      "play": { "cost": { "mana": 3 }, "target": { "type": "slot", "count": 1, "zones": ["bench"], "fill": "empty" }, "action": ["move_to:target", "next_phase"] }
    },
    {
      "key": "bull_elnuk",
      "text": "Bull Elnuk",
      "asset": "square:4:silver",
      "tags": ["unit"],
      "card_stats": { "power": 4, "health": 5, "cost": 4, "attacking": 0, "spill": 0 },
      "play": { "cost": { "mana": 4 }, "target": { "type": "slot", "count": 1, "zones": ["bench"], "fill": "empty" }, "action": ["move_to:target", "next_phase"] }
    },
    {
      "key": "vanguard_cavalry",
      "text": "Vanguard Cavalry",
      "asset": "square:5:gold",
      "tags": ["unit", "tough"],
      "card_stats": { "power": 5, "health": 5, "cost": 5, "attacking": 0, "spill": 0 },
      "play": { "cost": { "mana": 5 }, "target": { "type": "slot", "count": 1, "zones": ["bench"], "fill": "empty" }, "action": ["move_to:target", "next_phase"] }
    },
    {
      "key": "alpha_wildclaw",
      "text": "Alpha Wildclaw",
      "asset": "triangle:6:crimson",
      "tags": ["unit", "overwhelm"],
      "card_stats": { "power": 7, "health": 6, "cost": 6, "attacking": 0, "spill": 0 },
      "play": { "cost": { "mana": 6 }, "target": { "type": "slot", "count": 1, "zones": ["bench"], "fill": "empty" }, "action": ["move_to:target", "next_phase"] }
    },

    {
      "key": "north_wins",
      "text": "North wins",
      "story": "South's Nexus falls.",
      "play": { "action": ["load_game:menu.json"] }
    },
    {
      "key": "south_wins",
      "text": "South wins",
      "story": "North's Nexus falls.",
      "play": { "action": ["load_game:menu.json"] }
    },
    {
      "key": "pass_button",
      "text": "Pass",
      "tooltip": "Do nothing and hand over. Two passes in a row end the round; anything either of you does in between clears them. While attackers or blockers are being chosen it means \"done\".",
      "asset": "circle:1:slate",
      "tags": ["pass_button", "immutable"],
      "card_stats": { "passed": 0 },
      "abilities": [
        {
          "key": "pass",
          "text": "Pass",
          "phases": ["play"],
          "action": ["stat_set:passed@self:1", "next_phase"]
        },
        {
          "key": "done",
          "text": "Done",
          "phases": ["declare_attack", "declare_block"],
          "action": ["next_phase"]
        }
      ]
    },
    {
      "key": "attack_button",
      "text": "Attack",
      "tooltip": "Declare an attack. Only the seat holding this round's attack token may, and doing it spends the token.",
      "asset": "triangle:3:crimson",
      "tags": ["immutable"],
      "abilities": [
        {
          "key": "declare",
          "text": "Attack",
          "phases": ["play"],
          "cost": { "token": 1 },
          "action": ["stat_set:attack_declared@mine.player:1", "next_phase"]
        }
      ]
    }
  ],
  "setup": {
    "place": [
      { "card": "north", "zone": "nexus_north" },
      { "card": "south", "zone": "nexus_south" },
      { "card": "pass_button", "zone": "controls", "at": ["a1"] },
      { "card": "attack_button", "zone": "controls", "at": ["b1"] }
    ]
  }
}
